from fastapi import FastAPI, Depends, Query
from fastapi.responses import JSONResponse
from search import TextSearch
from lemmatization import Lemmatizer

# Корпус по умолчанию
DEFAULT_CORPUS = {
    "1": "мирный мир",
    "2": "бег трусцой",
    "3": "в бегущем мире",
}

_search_instance = TextSearch(DEFAULT_CORPUS)
_lemmatizer_instance = Lemmatizer()

def get_search() -> TextSearch:
    return _search_instance

def get_lemmatizer() -> Lemmatizer:
    return _lemmatizer_instance

app = FastAPI()

@app.get("/search/exact")
def exact_search(
    query: str = Query(...),
    search: TextSearch = Depends(get_search),
):
    result, error = search.exact_search(query)
    if error:
        return JSONResponse(
            status_code=400,
            content={"code": error, "message": f"Search failed: {error}"},
        )
    return result

@app.get("/search/word")
def word_search(
    query: str = Query(...),
    search: TextSearch = Depends(get_search),
):
    result, error = search.word_search(query)
    if error:
        return JSONResponse(
            status_code=400,
            content={"code": error, "message": f"Search failed: {error}"},
        )
    return result

@app.get("/search/root")
def root_search(
    query: str = Query(...),
    lang: str = Query(...),
    search: TextSearch = Depends(get_search),
):
    result, error = search.root_search(query, lang)
    if error:
        return JSONResponse(
            status_code=400,
            content={"code": error, "message": f"Search failed: {error}"},
        )
    return result

@app.get("/lemmatize")
def lemmatize(
    word: str = Query(...),
    lang: str = Query(...),
    lem: Lemmatizer = Depends(get_lemmatizer),
):
    result, error = lem.lemmatize(word, lang)
    if error:
        return JSONResponse(
            status_code=400,
            content={"code": error, "message": f"Lemmatization failed: {error}"},
        )
    return {"lemma": result}
