"""MOD-02: Выделение признака «месяц» из даты."""

from typing import Optional, Tuple

import pandas as pd


def add_month(df: pd.DataFrame) -> Tuple[Optional[pd.DataFrame], Optional[str]]:
    """Добавляет колонку month (int) на основе date.

    Ожидается формат YYYY-MM-DD. Возвращает (обогащённый DataFrame, None)
    или (None, код ошибки).
    """
    if "date" not in df.columns:
        return None, "INVALID_DATE_FORMAT"

    try:
        dates = pd.to_datetime(df["date"], format="%Y-%m-%d", errors="raise")
    except Exception:
        return None, "INVALID_DATE_FORMAT"

    df_enriched = df.copy()
    df_enriched["month"] = dates.dt.month
    return df_enriched, None
