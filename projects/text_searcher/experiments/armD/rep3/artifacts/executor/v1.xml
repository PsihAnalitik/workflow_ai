```file:test_search.py
from search import SearchEngine

CORPUS = {
    "1": "мирный мир",
    "2": "бег трусцой",
}

def test_exact_search_finds_all() -> None:
    engine = SearchEngine(CORPUS)
    results, err = engine.exact_search("мир")
    assert err is None
    assert len(results) == 1
    assert results[0]["text_id"] == "1"
    assert results[0]["positions"] == [0, 7]

def test_word_search_finds_only_whole_words() -> None:
    engine = SearchEngine(CORPUS)
    results, err = engine.word_search("мир")
    assert err is None
    assert len(results) == 1
    assert results[0]["text_id"] == "1"
    assert results[0]["positions"] == [7]  # "мир" as a whole word at position 7

def test_root_search_finds_by_lemma() -> None:
    engine = SearchEngine(CORPUS)
    results, err = engine.root_search("бег", "ru")
    assert err is None
    assert len(results) == 1
    assert results[0]["text_id"] == "2"
    assert results[0]["positions"] == [0]

def test_search_no_match_returns_empty_list() -> None:
    engine = SearchEngine(CORPUS)
    for method in ["exact_search", "word_search", "root_search"]:
        if method == "root_search":
            results, err = getattr(engine, method)("zzz", "ru")
        else:
            results, err = getattr(engine, method)("zzz")
        assert err is None
        assert results == []

def test_empty_query_returns_error() -> None:
    engine = SearchEngine(CORPUS)
    for method in ["exact_search", "word_search"]:
        _, err = getattr(engine, method)("")
        assert err == "EMPTY_QUERY"
    _, err = engine.root_search("", "ru")
    assert err == "EMPTY_QUERY"

def test_root_search_empty_language() -> None:
    engine = SearchEngine(CORPUS)
    _, err = engine.root_search("бег", "")
    assert err == "EMPTY_LANGUAGE"

def test_root_search_unsupported_language() -> None:
    engine = SearchEngine(CORPUS)
    _, err = engine.root_search("бег", "en")
    assert err == "UNSUPPORTED_LANGUAGE"
