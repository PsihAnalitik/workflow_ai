import pandas as pd
from mod_03_monthly_revenue import revenue_by_month

def test_happy_path() -> None:
    df = pd.DataFrame({
        "date": pd.to_datetime(["2025-01-15", "2025-01-20", "2025-02-10"]),
        "qty": [2, 3, 1],
        "price": [10, 10, 20]
    })
    result = revenue_by_month(df)
    expected = pd.DataFrame({
        "month": ["2025-01", "2025-02"],
        "revenue": [50, 20]   # Jan: 2*10+3*10=50, Feb: 1*20=20
    })
    pd.testing.assert_frame_equal(result.reset_index(drop=True), expected, check_dtype=False)

def test_empty_after_filter() -> None:
    df = pd.DataFrame({
        "date": pd.to_datetime(["2025-01-01"]),
        "qty": [None],
        "price": [100]
    })
    result = revenue_by_month(df)
    assert result.empty
    assert list(result.columns) == ["month", "revenue"]
