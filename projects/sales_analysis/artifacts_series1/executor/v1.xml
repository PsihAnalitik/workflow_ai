"""MOD-07: Формирование отчётных таблиц."""

from typing import Optional, Tuple

import pandas as pd


def build_report(
    revenue_by_category: pd.DataFrame,
    revenue_by_month: pd.DataFrame,
    top_products: pd.DataFrame,
    avg_check_by_region: pd.DataFrame,
    discarded_count: int,
) -> Tuple[Optional[str], Optional[str]]:
    """Собирает текстовый отчёт из агрегатов и счётчика отброшенных строк."""
    if any(
        arg is None
        for arg in [revenue_by_category, revenue_by_month, top_products, avg_check_by_region]
    ):
        return None, "MISSING_AGGREGATE"

    lines = []
    lines.append("=== Отчёт о продажах за квартал ===\n")
    lines.append("1. Выручка по категориям:")
    lines.append(revenue_by_category.to_string(index=False))
    lines.append("\n2. Выручка по месяцам:")
    lines.append(revenue_by_month.to_string(index=False))
    lines.append("\n3. Топ-3 продукта по выручке:")
    lines.append(top_products.to_string(index=False))
    lines.append("\n4. Средний чек по регионам:")
    lines.append(avg_check_by_region.to_string(index=False))
    lines.append(f"\n5. Отброшено строк с пропусками: {discarded_count}")
    return "\n".join(lines), None
