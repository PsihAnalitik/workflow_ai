import pandas as pd
import pytest

from src.module_01 import load_and_clean


def test_load_and_clean_happy_path(monkeypatch) -> None:
    """Все строки без пропусков – возвращается чистый DataFrame."""
    sample = pd.DataFrame({
        "date": ["2022-01-15", "2022-01-16"],
        "category": ["electronics", "home"],
        "product": ["phone", "vacuum"],
        "qty": [1, 2],
        "price": [100, 200],
        "region": ["msk", "spb"],
    })
    monkeypatch.setattr(pd, "read_csv", lambda path: sample.copy(deep=True))

    clean_df, discarded, err = load_and_clean("dummy.csv")
    assert err is None
    assert discarded == 0
    assert clean_df.shape[0] == 2
    assert "qty" in clean_df.columns
    assert clean_df["qty"].dtype == int


def test_load_and_clean_discards_rows_with_nans(monkeypatch) -> None:
    """Строки с пропусками в qty или price отбрасываются, счётчик корректен."""
    sample = pd.DataFrame({
        "date": ["2022-01-15", "2022-01-16", "2022-01-17"],
        "category": ["a", "b", "c"],
        "product": ["p1", "p2", "p3"],
        "qty": [1, None, 3],
        "price": [10.0, 20.0, None],
        "region": ["r1", "r2", "r3"],
    })
    monkeypatch.setattr(pd, "read_csv", lambda path: sample.copy(deep=True))

    clean_df, discarded, err = load_and_clean("dummy.csv")
    assert err is None
    assert discarded == 2  # строки 1 и 2 (0-index 1 и 2) имеют пропуски
    assert clean_df.shape[0] == 1
    assert clean_df.iloc[0]["product"] == "p1"


def test_load_and_clean_schema_mismatch(monkeypatch) -> None:
    """Отсутствует обязательная колонка – SCHEMA_MISMATCH."""
    sample = pd.DataFrame({"date": ["2022-01-01"], "category": ["a"]})
    monkeypatch.setattr(pd, "read_csv", lambda path: sample.copy(deep=True))

    clean_df, discarded, err = load_and_clean("dummy.csv")
    assert clean_df is None
    assert discarded is None
    assert err == "SCHEMA_MISMATCH"


def test_load_and_clean_file_read_error(monkeypatch) -> None:
    """Ошибка чтения файла – FILE_READ_ERROR."""
    def raise_error(path):
        raise OSError("file not found")
    monkeypatch.setattr(pd, "read_csv", raise_error)

    clean_df, discarded, err = load_and_clean("nonexistent.csv")
    assert clean_df is None
    assert discarded is None
    assert err == "FILE_READ_ERROR"
