```file:search.py
import re
from typing import Dict, List, Optional, Tuple

from lemmatization import lemmatize


class SearchResult:
    def __init__(self, text_id: str, positions: List[int]):
        self.text_id = text_id
        self.positions = positions

    def to_dict(self) -> dict:
        return {"text_id": self.text_id, "positions": self.positions}


class SearchEngine:
    def __init__(self, corpus: Dict[str, str]):
        self.corpus = corpus
        self._lemma_index: Dict[str, List[Tuple[str, int]]] = {}
        self._build_lemma_index()

    def _build_lemma_index(self) -> None:
        for text_id, text in self.corpus.items():
            tokens = []
            for match in re.finditer(r'\b\w+\b', text):
                word = match.group()
                start = match.start()
                tokens.append((word, start))
            self._lemma_index[text_id] = tokens

    def exact_search(self, query: str) -> Optional[List[SearchResult]]:
        if not query:
            return None
        results = []
        for text_id, text in self.corpus.items():
            positions = []
            start = 0
            while True:
                pos = text.find(query, start)
                if pos == -1:
                    break
                positions.append(pos)
                start = pos + 1
            if positions:
                results.append(SearchResult(text_id, positions))
        return results

    def word_search(self, query: str) -> Optional[List[SearchResult]]:
        if not query:
            return None
        pattern = r'\b' + re.escape(query) + r'\b'
        results = []
        for text_id, text in self.corpus.items():
            positions = [m.start() for m in re.finditer(pattern, text)]
            if positions:
                results.append(SearchResult(text_id, positions))
        return results

    def root_search(self, query: str, lang: str) -> Optional[List[SearchResult]]:
        if not query:
            return None
        if not lang:
            return None
        if lang != 'ru':
            return None
        query_words = query.split()
        lemma_query = []
        for word in query_words:
            lemma_result = lemmatize(word, lang)
            if lemma_result is None:
                lemma_query.append(word)
            else:
                lemma_query.append(lemma_result)
        results = []
        for text_id, tokens in self._lemma_index.items():
            token_lemmas = []
            for token_word, token_start in tokens:
                lemma_result = lemmatize(token_word, lang)
                if lemma_result is None:
                    token_lemmas.append((token_word, token_start))
                else:
                    token_lemmas.append((lemma_result, token_start))
            # search for continuous subsequence
            for i in range(len(token_lemmas) - len(lemma_query) + 1):
                match = True
                for j in range(len(lemma_query)):
                    if token_lemmas[i + j][0] != lemma_query[j]:
                        match = False
                        break
                if match:
                    start_pos = token_lemmas[i][1]
                    results.append(SearchResult(text_id, [start_pos]))
                    break
        return results
