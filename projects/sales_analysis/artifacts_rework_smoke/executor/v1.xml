import pandas as pd
from modules.mod_05_avg_check_region import avg_check_by_region

def test_avg_check_happy_path():
    df = pd.DataFrame({
        "region": ["r1", "r1", "r2"],
        "qty": [1, 2, 3],
        "price": [10, 20, 10],
    })
    # r1: транзакции 10 и 40, среднее = 25; r2: 30, среднее = 30
    result = avg_check_by_region(df)
    assert set(result["region"]) == {"r1", "r2"}
    r1_row = result[result["region"] == "r1"]
    assert abs(r1_row["avg_check"].values[0] - 25.0) < 1e-9
    r2_row = result[result["region"] == "r2"]
    assert abs(r2_row["avg_check"].values[0] - 30.0) < 1e-9

def test_avg_check_empty():
    df = pd.DataFrame(columns=["region", "qty", "price"])
    result = avg_check_by_region(df)
    assert result.empty
    assert list(result.columns) == ["region", "avg_check"]
