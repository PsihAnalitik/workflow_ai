```file:lemmatization.py
import pymorphy3
from typing import Tuple, Optional

_morph = pymorphy3.MorphAnalyzer()

def lemmatize(word: str, lang: str) -> Tuple[Optional[str], Optional[str]]:
    if not word:
        return None, "EMPTY_WORD"
    if not lang:
        return None, "EMPTY_LANGUAGE"
    if lang != "ru":
        return None, "UNSUPPORTED_LANGUAGE"

    parsed = _morph.parse(word)
    if parsed:
        return parsed[0].normal_form, None
    else:
        return word, None
