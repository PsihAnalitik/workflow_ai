<domains project="portfolio_core" version="1" derived_from="requirements.xml@1">
  <!-- WHY: выбрано разбиение на 3 домена (profile, case, showcase) вместо 2 (content+showcase)
       или 4 (profile, case, media, taxonomy). Вариант 2 объединял бы профиль и кейсы в один
       контекст, но у них разные единые языки (профиль vs кейс/изображение) и разная
       ответственность (сайт-синглтон vs коллекция сущностей). Вариант 4 выделял бы медиа
       в отдельный домен, но изображения жёстко принадлежат кейсу и не имеют смысла вне его;
       выделение таксономии (категории/теги) в отдельный домен создало бы избыточную
       связанность ради классификатора, который не меняется независимо от кейсов. -->
  
  <domain id="D-01" name="profile">
    <responsibility>Хранение и выдача профиля сайта-синглтона</responsibility>
    <covers>FR-01, FR-09</covers>
    <ubiquitous_language>
      <term name="профиль">единственная запись с именем, титулом, био, аватаром, баннером, контактами, соцссылками, клиентами, активной темой</term>
      <term name="сайт">инсталляция, владеющая ровно одним профилем</term>
    </ubiquitous_language>
    <owns>профиль сайта</owns>
    <emits/>
  </domain>

  <domain id="D-02" name="case">
    <responsibility>Управление кейсами, их изображениями и таксономией</responsibility>
    <covers>FR-02, FR-03, FR-04, FR-05, FR-06, FR-12, FR-13, FR-14</covers>
    <ubiquitous_language>
      <term name="кейс">единица портфолио со slug, названием, описанием, обложкой, датой, порядком, статусом, SEO-полями</term>
      <term name="изображение">файл кейса с alt, подписью и порядком; принадлежит ровно одному кейсу</term>
      <term name="категория">рубрика, адресуемая slug; кейс относится ровно к одной</term>
      <term name="тег">метка, адресуемая slug; кейс имеет 0..N тегов</term>
      <term name="статус">draft или published; определяет видимость в витрине</term>
      <term name="порядок">целое число, задающее позицию кейса в сортировке</term>
    </ubiquitous_language>
    <owns>кейсы, изображения, категории, теги, связи кейс-категория и кейс-теги</owns>
    <emits>событие изменения статуса кейса</emits>
    <!-- WHY: emits событие, а не владеет read-моделью витрины — витрина отдельный домен (NFR-05),
         административный домен лишь уведомляет об изменениях -->
  </domain>

  <domain id="D-03" name="showcase">
    <responsibility>Формирование read-модели витрины: списки, детализация, соседние кейсы, категории для фильтра</responsibility>
    <covers>FR-07, FR-08, FR-10, FR-11</covers>
    <ubiquitous_language>
      <term name="витрина">публичная проекция кейсов и профиля только со статусом published</term>
      <term name="соседние кейсы">предыдущий и следующий опубликованный кейс в порядке сортировки</term>
      <term name="категория фильтра">категория, имеющая хотя бы один опубликованный кейс</term>
    </ubiquitous_language>
    <owns>read-модель витрины (проекции кейсов, профиля, категорий)</owns>
    <emits/>
  </domain>

  <relationships>
    <!-- WHY: showcase зависит от profile синхронно, потому что витрина не может
         отобразить страницу без профиля; async здесь привёл бы к несогласованности
         при первом запросе после деплоя -->
    <edge from="D-03" to="D-01" kind="sync" via="C-profile-read" data="профиль сайта"/>
    
    <!-- WHY: showcase зависит от case синхронно для первичной загрузки read-модели
         (холодный старт витрины), но подписывается асинхронно на события изменения
         статуса для инвалидации/обновления проекций. Два ребра — два разных контракта -->
    <edge from="D-03" to="D-02" kind="sync" via="C-case-read" data="опубликованные кейсы, категории, теги"/>
    <edge from="D-03" to="D-02" kind="async" via="C-case-events" data="событие изменения статуса кейса"/>
  </relationships>
</domains>