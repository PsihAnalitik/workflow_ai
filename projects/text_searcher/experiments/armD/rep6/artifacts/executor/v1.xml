```file:search.py
import re
from typing import Dict, List, Tuple, Optional

from lemmatization import Lemmatizer


class SearchEngine:
    """Поисковый модуль, работающий со статическим in-memory корпусом текстов."""

    def __init__(
        self, corpus: Dict[str, str], lemmatizer: Optional[Lemmatizer] = None
    ) -> None:
        self.corpus = corpus
        self.lemmatizer = lemmatizer
        # Предвычисленный индекс лемм для root-поиска: text_id -> list of (lemma, start_pos)
        self._lemma_index: Dict[str, List[Tuple[str, int]]] = {}
        if lemmatizer is not None:
            self._build_lemma_index()

    def _build_lemma_index(self) -> None:
        for text_id, text in self.corpus.items():
            tokens: List[Tuple[str, int]] = []
            for match in re.finditer(r'\w+', text):
                word = match.group()
                lemma, err = self.lemmatizer.lemmatize(word, 'ru')  # type: ignore[union-attr]
                if err:
                    lemma = word
                tokens.append((lemma, match.start()))
            self._lemma_index[text_id] = tokens

    # ------------------------------------------------------------------
    # Точный поиск подстроки
    # ------------------------------------------------------------------
    def exact_search(
        self, query: str
    ) -> Tuple[Optional[List[dict]], Optional[str]]:
        if not query:
            return None, "EMPTY_QUERY"

        results: List[dict] = []
        for text_id, text in self.corpus.items():
            positions = []
            start = 0
            while True:
                idx = text.find(query, start)
                if idx == -1:
                    break
                positions.append(idx)
                start = idx + 1
            if positions:
                results.append({"text_id": text_id, "positions": positions})

        return results, None

    # ------------------------------------------------------------------
    # Поиск целого слова (границы слова через \b)
    # ------------------------------------------------------------------
    def word_search(
        self, query: str
    ) -> Tuple[Optional[List[dict]], Optional[str]]:
        if not query:
            return None, "EMPTY_QUERY"

        pattern = r'\b' + re.escape(query) + r'\b'
        results: List[dict] = []
        for text_id, text in self.corpus.items():
            positions = [m.start() for m in re.finditer(pattern, text)]
            if positions:
                results.append({"text_id": text_id, "positions": positions})

        return results, None

    # ------------------------------------------------------------------
    # Поиск по корню (лемме)
    # ------------------------------------------------------------------
    def root_search(
        self, query: str, lang: str
    ) -> Tuple[Optional[List[dict]], Optional[str]]:
        if not query:
            return None, "EMPTY_QUERY"
        if not lang:
            return None, "EMPTY_LANGUAGE"
        if lang != "ru":
            return None, "UNSUPPORTED_LANGUAGE"

        # Лемматизируем запрос
        query_words = query.split()
        lemma_query: List[str] = []
        for w in query_words:
            lemma, err = self.lemmatizer.lemmatize(w, lang)  # type: ignore[union-attr]
            if err:
                return None, err
            lemma_query.append(lemma)

        results: List[dict] = []
        for text_id, tokens in self._lemma_index.items():
            n = len(lemma_query)
            if n == 0:
                continue
            # Ищем непрерывную подпоследовательность lemma_query в списке токенов
            for i in range(len(tokens) - n + 1):
                match = True
                for j in range(n):
                    if tokens[i + j][0] != lemma_query[j]:
                        match = False
                        break
                if match:
                    results.append({
                        "text_id": text_id,
                        "positions": [tokens[i][1]]
                    })
                    # По спецификации — только первое вхождение в тексте
                    break

        return results, None
