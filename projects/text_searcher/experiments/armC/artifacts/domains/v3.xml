<domains project="text_search" version="1" derived_from="requirements.xml@1">
  <!-- WHY: выбрано разбиение на два домена (search + lemmatization), а не один монолитный.
       Альтернатива «единый домен» смешивает морфологию и поиск, нарушая принцип единственной
       ответственности и затрудняя независимую эволюцию лемматизации (например, добавление
       нового языка). Вариант с тремя доменами (по каждому FR) отвергнут как избыточный:
       точный/пословный/корневой поиск оперируют одним корпусом и единым языком поиска. -->
  <domain id="D-01" name="search">
    <responsibility>Поиск вхождений запроса в корпус текстов: точный, по полному слову, по корню (с использованием лемматизации)</responsibility>
    <covers>FR-01, FR-02, FR-03</covers>
    <ubiquitous_language>
      <term name="запрос">строка, которую ищет пользователь</term>
      <term name="корпус">набор текстов, в которых выполняется поиск</term>
      <term name="вхождение">факт совпадения запроса с фрагментом корпуса</term>
      <term name="точный поиск">поиск подстроки без учёта границ слов</term>
      <term name="поиск по слову">поиск с учётом границ слова</term>
      <term name="поиск по корню">поиск с приведением запроса и слов корпуса к нормальной форме (лемме)</term>
    </ubiquitous_language>
    <owns>корпус текстов, результаты поиска</owns>
    <emits/>
  </domain>

  <domain id="D-02" name="lemmatization">
    <responsibility>Приведение словоформ к нормальной форме (лемматизация) для поддерживаемых языков</responsibility>
    <!-- FR-03 покрывается D-01; D-02 – обеспечивающий домен, не привязанный напрямую к FR -->
    <ubiquitous_language>
      <term name="словоформа">конкретная грамматическая форма слова</term>
      <term name="лемма">нормальная (словарная) форма слова</term>
      <term name="нормальная форма">синоним леммы</term>
      <term name="язык">идентификатор языка, для которого применяется лемматизация</term>
    </ubiquitous_language>
    <owns>правила лемматизации, словари</owns>
    <emits/>
  </domain>

  <relationships>
    <!-- WHY: корневой поиск требует немедленного получения леммы для сравнения → синхронный вызов -->
    <edge from="D-01" to="D-02" kind="sync" via="C-lemmatize" data="запрос: словоформа, язык; ответ: лемма"/>
  </relationships>
</domains>