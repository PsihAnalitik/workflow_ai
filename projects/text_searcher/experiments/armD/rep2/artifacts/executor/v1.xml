from fastapi import FastAPI, Query
from fastapi.responses import JSONResponse
from search import SearchEngine, SearchResult
from lemmatization import lemmatize

app = FastAPI()

# Static in-memory corpus
CORPUS = {
    "1": "мирный мир",
    "2": "бег трусцой",
    "3": "qwerty test",
}

search_engine = SearchEngine(CORPUS)


def _error_response(code: str, message: str) -> JSONResponse:
    return JSONResponse(status_code=400, content={"code": code, "message": message})


@app.get("/search/exact")
def exact_search(query: str = Query(...)):
    result = search_engine.exact_search(query)
    if result is None:
        return _error_response("EMPTY_QUERY", "query is empty")
    return JSONResponse(status_code=200, content=[r.to_dict() for r in result])


@app.get("/search/word")
def word_search(query: str = Query(...)):
    result = search_engine.word_search(query)
    if result is None:
        return _error_response("EMPTY_QUERY", "query is empty")
    return JSONResponse(status_code=200, content=[r.to_dict() for r in result])


@app.get("/search/root")
def root_search(query: str = Query(...), lang: str = Query(...)):
    if not query:
        return _error_response("EMPTY_QUERY", "query is empty")
    if not lang:
        return _error_response("EMPTY_LANGUAGE", "language is empty")
    if lang != 'ru':
        return _error_response("UNSUPPORTED_LANGUAGE", f"language '{lang}' is not supported")
    result = search_engine.root_search(query, lang)
    if result is None:
        return _error_response("EMPTY_QUERY", "query is empty")
    return JSONResponse(status_code=200, content=[r.to_dict() for r in result])


@app.get("/lemmatize")
def lemmatize_endpoint(word: str = Query(...), lang: str = Query(...)):
    if not word:
        return _error_response("EMPTY_WORD", "word is empty")
    if not lang:
        return _error_response("EMPTY_LANGUAGE", "language is empty")
    if lang != 'ru':
        return _error_response("UNSUPPORTED_LANGUAGE", f"language '{lang}' is not supported")
    lemma = lemmatize(word, lang)
    if lemma is None:
        return _error_response("EMPTY_WORD", "word is empty")
    return JSONResponse(status_code=200, content={"lemma": lemma})
