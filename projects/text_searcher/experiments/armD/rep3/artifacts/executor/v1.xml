from lemmatization import lemmatize

def test_happy_known_word() -> None:
    lemma, err = lemmatize("столы", "ru")
    assert err is None
    assert lemma == "стол"

def test_unknown_word_returns_itself() -> None:
    lemma, err = lemmatize("qwerty", "ru")
    assert err is None
    assert lemma == "qwerty"

def test_empty_word() -> None:
    _, err = lemmatize("", "ru")
    assert err == "EMPTY_WORD"

def test_empty_language() -> None:
    _, err = lemmatize("word", "")
    assert err == "EMPTY_LANGUAGE"

def test_unsupported_language() -> None:
    _, err = lemmatize("word", "fr")
    assert err == "UNSUPPORTED_LANGUAGE"
