"""MOD-01: Загрузка и очистка данных."""

from typing import Optional, Tuple

import pandas as pd


def load_and_clean(filepath: str) -> Tuple[Optional[pd.DataFrame], Optional[int], Optional[str]]:
    """Читает CSV, проверяет схему, считает и удаляет пропуски в qty/price.

    Возвращает (чистый DataFrame, количество отброшенных строк, ошибка) или
    (None, None, код ошибки) при сбое.
    """
    try:
        df = pd.read_csv(filepath)
    except Exception:
        return None, None, "FILE_READ_ERROR"

    expected_columns = {"date", "category", "product", "qty", "price", "region"}
    if not expected_columns.issubset(df.columns):
        return None, None, "SCHEMA_MISMATCH"

    mask_missing = df[["qty", "price"]].isna().any(axis=1)
    discarded_count = int(mask_missing.sum())

    clean_df = df[~mask_missing].copy()
    clean_df["qty"] = clean_df["qty"].astype(int)
    clean_df["price"] = clean_df["price"].astype(int)

    return clean_df, discarded_count, None
