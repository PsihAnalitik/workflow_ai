from fastapi import FastAPI, Query
from fastapi.responses import JSONResponse
from search import SearchEngine
from lemmatization import lemmatize

app = FastAPI()

# Static in-memory corpus
CORPUS = {
    "doc1": "мирный мир",
    "doc2": "бег трусцой",
    "doc3": "qwerty test",
    "doc4": "бегущий человек",
}

engine = SearchEngine(CORPUS)

ERROR_MAP = {
    "EMPTY_QUERY": "Query is empty",
    "EMPTY_LANGUAGE": "Language is empty",
    "UNSUPPORTED_LANGUAGE": "Language is not supported",
}


def _error_response(code: str) -> JSONResponse:
    return JSONResponse(
        status_code=400,
        content={"code": code, "message": ERROR_MAP.get(code, "Unknown error")},
    )


@app.get("/search/exact")
def search_exact(query: str = Query(...)):
    result = engine.exact_search(query)
    if result is None:
        return _error_response("EMPTY_QUERY")
    return [r.to_dict() for r in result]


@app.get("/search/word")
def search_word(query: str = Query(...)):
    result = engine.word_search(query)
    if result is None:
        return _error_response("EMPTY_QUERY")
    return [r.to_dict() for r in result]


@app.get("/search/root")
def search_root(query: str = Query(...), lang: str = Query(...)):
    result = engine.root_search(query, lang)
    if result is None:
        if not query:
            return _error_response("EMPTY_QUERY")
        if not lang:
            return _error_response("EMPTY_LANGUAGE")
        if lang != 'ru':
            return _error_response("UNSUPPORTED_LANGUAGE")
    return [r.to_dict() for r in result]


@app.get("/lemmatize")
def lemmatize_endpoint(word: str = Query(...), lang: str = Query(...)):
    result = lemmatize(word, lang)
    if result is None:
        if not word:
            return _error_response("EMPTY_WORD")
        if not lang:
            return _error_response("EMPTY_LANGUAGE")
        if lang != 'ru':
            return _error_response("UNSUPPORTED_LANGUAGE")
    return {"lemma": result}
```

```file:lemmatization.py
from typing import Optional
import pymorphy3


_analyzer = pymorphy3.MorphAnalyzer()


def lemmatize(word: str, lang: str) -> Optional[str]:
    if not word:
        return None  # EMPTY_WORD
    if not lang:
        return None  # EMPTY_LANGUAGE
    if lang != 'ru':
        return None  # UNSUPPORTED_LANGUAGE
    parsed = _analyzer.parse(word)
    if parsed:
        return parsed[0].normal_form
    return word
