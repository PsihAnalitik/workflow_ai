```file:lemmatization.py
import pymorphy3

def lemmatize(word: str, lang: str) -> tuple[str | None, str | None]:
    if not word:
        return None, "EMPTY_WORD"
    if not lang:
        return None, "EMPTY_LANGUAGE"
    if lang != "ru":
        return None, "UNSUPPORTED_LANGUAGE"
    morph = pymorphy3.MorphAnalyzer()
    parse = morph.parse(word)
    if parse:
        lemma = parse[0].normal_form
    else:
        lemma = word
    return lemma, None
