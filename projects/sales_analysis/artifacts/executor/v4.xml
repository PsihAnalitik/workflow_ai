```file:exclude_missing.py
import pandas as pd
from typing import Tuple

def exclude_missing(df: pd.DataFrame) -> Tuple[pd.DataFrame, int]:
    """
    Исключает строки с пропусками в колонках qty или price.
    Возвращает кортеж (clean_df, excluded_count).
    Если входной DataFrame пуст, возвращает (пустой DataFrame, 0).
    """
    if df.empty:
        return df.copy(), 0
    missing_mask = df['qty'].isna() | df['price'].isna()
    excluded_count = int(missing_mask.sum())
    clean_df = df[~missing_mask].copy()
    return clean_df, excluded_count
```

