"""MOD-03: Агрегация выручки по категориям."""

from typing import Optional, Tuple

import pandas as pd


def revenue_by_category(df: pd.DataFrame) -> Tuple[Optional[pd.DataFrame], Optional[str]]:
    """Суммарная выручка (qty * price) по категориям."""
    if df.empty:
        return None, "EMPTY_DATASET"

    df = df.copy()
    df["revenue"] = df["qty"] * df["price"]
    result = (
        df.groupby("category", as_index=False)
        .agg(revenue=("revenue", "sum"))
        .sort_values("revenue", ascending=False)
        .reset_index(drop=True)
    )
    return result, None
```

