import pymorphy3
from typing import Tuple, Optional


class Lemmatizer:
    """Модуль лемматизации словоформ для заданного языка (RU)."""

    def __init__(self) -> None:
        self._analyzer = pymorphy3.MorphAnalyzer()

    def lemmatize(self, word: str, lang: str) -> Tuple[Optional[str], Optional[str]]:
        """
        Приводит словоформу к нормальной форме (лемме).

        Возвращает кортеж (lemma, error):
        - при успехе: (лемма, None)
        - при ошибке: (None, код_ошибки)
        """
        if not word:
            return None, "EMPTY_WORD"
        if not lang:
            return None, "EMPTY_LANGUAGE"
        if lang != "ru":
            return None, "UNSUPPORTED_LANGUAGE"

        parsed = self._analyzer.parse(word)
        if parsed:
            lemma = parsed[0].normal_form
        else:
            lemma = word
        return lemma, None
