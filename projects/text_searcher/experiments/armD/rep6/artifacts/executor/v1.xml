from search import SearchEngine
from lemmatization import Lemmatizer


def _make_engine(corpus=None):
    if corpus is None:
        corpus = {
            "a": "мирный мир",
            "b": "бег трусцой",
            "c": "привет мир",
        }
    lem = Lemmatizer()
    return SearchEngine(corpus, lem)


class TestExactSearch:
    def test_happy(self) -> None:
        eng = _make_engine()
        res, err = eng.exact_search("мир")
        assert err is None
        assert len(res) == 2
        for r in res:
            if r["text_id"] == "a":
                assert r["positions"] == [0, 7]
            elif r["text_id"] == "c":
                assert r["positions"] == [7]

    def test_empty_query(self) -> None:
        eng = _make_engine()
        res, err = eng.exact_search("")
        assert res is None
        assert err == "EMPTY_QUERY"

    def test_no_match(self) -> None:
        eng = _make_engine()
        res, err = eng.exact_search("xyz")
        assert err is None
        assert res == []


class TestWordSearch:
    def test_happy(self) -> None:
        eng = _make_engine()
        res, err = eng.word_search("мир")
        assert err is None
        assert len(res) == 2
        for r in res:
            if r["text_id"] == "a":
                assert r["positions"] == [7]
            elif r["text_id"] == "c":
                assert r["positions"] == [7]

    def test_empty_query(self) -> None:
        eng = _make_engine()
        res, err = eng.word_search("")
        assert res is None
        assert err == "EMPTY_QUERY"

    def test_no_match(self) -> None:
        eng = _make_engine()
        res, err = eng.word_search("xyz")
        assert err is None
        assert res == []


class TestRootSearch:
    def test_happy(self) -> None:
        eng = _make_engine({"d": "бег трусцой"})
        res, err = eng.root_search("бегу", "ru")
        assert err is None
        assert len(res) == 1
        assert res[0]["text_id"] == "d"
        assert res[0]["positions"] == [0]

    def test_empty_query(self) -> None:
        eng = _make_engine()
        res, err = eng.root_search("", "ru")
        assert res is None
        assert err == "EMPTY_QUERY"

    def test_empty_lang(self) -> None:
        eng = _make_engine()
        res, err = eng.root_search("бегу", "")
        assert res is None
        assert err == "EMPTY_LANGUAGE"

    def test_unsupported_lang(self) -> None:
        eng = _make_engine()
        res, err = eng.root_search("бегу", "en")
        assert res is None
        assert err == "UNSUPPORTED_LANGUAGE"

    def test_no_match(self) -> None:
        eng = _make_engine()
        res, err = eng.root_search("xupiter", "ru")
        assert err is None
        assert res == []

    def test_unknown_word_used_as_is(self) -> None:
        eng = _make_engine({"d": "qwerty asdf"})
        res, err = eng.root_search("qwerty", "ru")
        assert err is None
        assert len(res) == 1
        assert res[0]["text_id"] == "d"
