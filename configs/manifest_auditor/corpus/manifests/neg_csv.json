{
  "server": "csv_tools",
  "tools": [
    {
      "name": "read_csv",
      "description": "Read a CSV file and return rows as objects.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path to the CSV file"
          },
          "delimiter": {
            "type": "string",
            "description": "Field delimiter, default is a comma"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "describe_csv",
      "description": "Return column names, types and row count of a CSV.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path to the CSV file"
          }
        },
        "required": [
          "path"
        ]
      }
    }
  ]
}
