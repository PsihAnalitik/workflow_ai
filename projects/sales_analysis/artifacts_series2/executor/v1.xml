import sys
import pandas as pd
from mod_01_discarded import count_discarded
from mod_02_category_revenue import revenue_by_category
from mod_03_monthly_revenue import revenue_by_month
from mod_04_top_products import top_products
from mod_05_avg_receipt import avg_receipt_by_region

def main() -> None:
    if len(sys.argv) != 2:
        print("Usage: python main.py <path_to_csv>")
        sys.exit(1)
    path = sys.argv[1]
    df = pd.read_csv(path, parse_dates=["date"], dtype={"qty": "Int64", "price": "Int64"})
    
    # MOD-01
    discarded = count_discarded(df)
    print(f"Исключено строк из-за пропусков: {discarded}\n")
    
    # MOD-02
    cat_rev = revenue_by_category(df)
    print("Выручка по категориям:")
    print(cat_rev.to_string(index=False))
    print()
    
    # MOD-03
    month_rev = revenue_by_month(df)
    print("Выручка по месяцам:")
    print(month_rev.to_string(index=False))
    print()
    
    # MOD-04
    top = top_products(df)
    print("Топ-3 продукта по выручке:")
    print(top.to_string(index=False))
    print()
    
    # MOD-05
    region_avg = avg_receipt_by_region(df)
    print("Средний чек по регионам:")
    print(region_avg.to_string(index=False))

if __name__ == "__main__":
    main()
