```file:mod_01_discarded.py
import pandas as pd

def count_discarded(df: pd.DataFrame) -> int:
    """Количество строк с пропущенными значениями qty или price."""
    if df.empty:
        return 0
    discarded = df["qty"].isna() | df["price"].isna()
    return int(discarded.sum())
```

```file:mod_02_category_revenue.py
import pandas as pd

def revenue_by_category(df: pd.DataFrame) -> pd.DataFrame:
    """Выручка по категориям. Строки с null в qty/price отбрасываются."""
    if df.empty:
        return pd.DataFrame(columns=["category", "revenue"])
    clean = df.dropna(subset=["qty", "price"]).copy()
    if clean.empty:
        return pd.DataFrame(columns=["category", "revenue"])
    clean["revenue"] = clean["qty"] * clean["price"]
    result = clean.groupby("category", as_index=False).agg(revenue=("revenue", "sum"))
    return result
```

```file:mod_03_monthly_revenue.py
import pandas as pd

def revenue_by_month(df: pd.DataFrame) -> pd.DataFrame:
    """Выручка по месяцам (YYYY-MM). Строки с пропусками исключаются."""
    if df.empty:
        return pd.DataFrame(columns=["month", "revenue"])
    clean = df.dropna(subset=["qty", "price"]).copy()
    if clean.empty:
        return pd.DataFrame(columns=["month", "revenue"])
    clean["month"] = clean["date"].dt.strftime("%Y-%m")
    clean["revenue"] = clean["qty"] * clean["price"]
    result = clean.groupby("month", as_index=False).agg(revenue=("revenue", "sum"))
    result = result.sort_values("month")
    return result
```

```file:mod_04_top_products.py
import pandas as pd

def top_products(df: pd.DataFrame) -> pd.DataFrame:
    """Топ-3 продукта по выручке. Пропуски отбрасываются."""
    if df.empty:
        return pd.DataFrame(columns=["product", "revenue"])
    clean = df.dropna(subset=["qty", "price"]).copy()
    if clean.empty:
        return pd.DataFrame(columns=["product", "revenue"])
    clean["revenue"] = clean["qty"] * clean["price"]
    grouped = clean.groupby("product", as_index=False)["revenue"].sum()
    grouped = grouped.sort_values("revenue", ascending=False).head(3)
    return grouped
```

```file:mod_05_avg_receipt.py
import pandas as pd

def avg_receipt_by_region(df: pd.DataFrame) -> pd.DataFrame:
    """Средний чек по регионам. Пропуски в qty/price исключаются."""
    if df.empty:
        return pd.DataFrame(columns=["region", "avg_receipt"])
    clean = df.dropna(subset=["qty", "price"]).copy()
    if clean.empty:
        return pd.DataFrame(columns=["region", "avg_receipt"])
    clean["revenue"] = clean["qty"] * clean["price"]
    agg = clean.groupby("region").agg(
        total_revenue=("revenue", "sum"),
        transaction_count=("revenue", "size")
    ).reset_index()
    agg["avg_receipt"] = (agg["total_revenue"] / agg["transaction_count"]).round(2)
    return agg[["region", "avg_receipt"]]
```

