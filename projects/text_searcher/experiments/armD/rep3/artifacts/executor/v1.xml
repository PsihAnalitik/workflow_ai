from fastapi import FastAPI, Query
from fastapi.responses import JSONResponse
from search import SearchEngine

# Предопределённый корпус текстов
CORPUS = {
    "1": "мирный мир",
    "2": "бег трусцой",
    "3": "hello world",
}

engine = SearchEngine(CORPUS)

app = FastAPI()

ERROR_MESSAGES = {
    "EMPTY_QUERY": "Query is empty",
    "EMPTY_LANGUAGE": "Language is empty",
    "UNSUPPORTED_LANGUAGE": "Unsupported language",
    "EMPTY_WORD": "Word is empty",
}

def error_response(code: str) -> JSONResponse:
    return JSONResponse(
        status_code=400,
        content={"code": code, "message": ERROR_MESSAGES.get(code, code)},
    )

@app.get("/search/exact")
def search_exact(query: str = Query(...)):
    results, err = engine.exact_search(query)
    if err:
        return error_response(err)
    return JSONResponse(status_code=200, content=results)

@app.get("/search/word")
def search_word(query: str = Query(...)):
    results, err = engine.word_search(query)
    if err:
        return error_response(err)
    return JSONResponse(status_code=200, content=results)

@app.get("/search/root")
def search_root(query: str = Query(...), lang: str = Query(...)):
    results, err = engine.root_search(query, lang)
    if err:
        return error_response(err)
    return JSONResponse(status_code=200, content=results)

@app.get("/lemmatize")
def lemmatize(word: str = Query(...), lang: str = Query(...)):
    from lemmatization import lemmatize as lemmatize_func
    lemma, err = lemmatize_func(word, lang)
    if err:
        return error_response(err)
    return JSONResponse(status_code=200, content={"lemma": lemma})
