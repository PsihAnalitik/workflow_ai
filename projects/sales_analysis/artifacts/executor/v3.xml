```file:mod_06_avg_receipt.py
import pandas as pd

def avg_receipt_by_region(df: pd.DataFrame) -> pd.DataFrame:
    """Средний чек по регионам: столбцы region, avg_receipt."""
    if df.empty:
        return pd.DataFrame(columns=["region", "avg_receipt"])

    df = df.copy()
    df["revenue"] = df["qty"] * df["price"]
    result = (
        df.groupby("region", as_index=False)
        .agg(
            total_revenue=("revenue", "sum"),
            transaction_count=("revenue", "size"),
        )
    )
    result["avg_receipt"] = result["total_revenue"] / result["transaction_count"]
    result = result[["region", "avg_receipt"]]
    return result
```

```file:mod_07_report.py
from typing import Any
import pandas as pd

def format_report(
    revenue_cat: pd.DataFrame,
    revenue_month: pd.DataFrame,
    top3: pd.DataFrame,
    avg_receipt: pd.DataFrame,
    excluded_count: int,
) -> str:
    """Формирует текстовый отчёт с заголовками и таблицами."""
    lines = []
    lines.append("Выручка по категориям")
    lines.append(revenue_cat.to_string(index=False) if not revenue_cat.empty else "Нет данных")
    lines.append("")
    lines.append("Выручка по месяцам")
    lines.append(revenue_month.to_string(index=False) if not revenue_month.empty else "Нет данных")
    lines.append("")
    lines.append("Топ-3 продукта")
    lines.append(top3.to_string(index=False) if not top3.empty else "Нет данных")
    lines.append("")
    lines.append("Средний чек по регионам")
    lines.append(avg_receipt.to_string(index=False) if not avg_receipt.empty else "Нет данных")
    lines.append("")
    lines.append(f"Исключено строк с пропусками: {excluded_count}")
    return "\n".join(lines)
