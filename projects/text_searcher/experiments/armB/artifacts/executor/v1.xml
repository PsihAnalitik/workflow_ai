from typing import Optional, Tuple

import pymorphy3

class Lemmatizer:
    """Приведение словоформы к нормальной форме."""

    def __init__(self) -> None:
        self._morph = pymorphy3.MorphAnalyzer()

    def lemmatize(self, word: str, lang: str) -> Tuple[Optional[str], Optional[str]]:
        """Возвращает (лемма, ошибка)."""
        if not word:
            return None, "EMPTY_WORD"
        if not lang:
            return None, "EMPTY_LANGUAGE"
        if lang != "ru":
            return None, "UNSUPPORTED_LANGUAGE"

        parsed = self._morph.parse(word)
        if parsed:
            lemma = parsed[0].normal_form
        else:
            lemma = word
        return lemma, None
