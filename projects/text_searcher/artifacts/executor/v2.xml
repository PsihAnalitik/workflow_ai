```file:test_lemmatization.py
from lemmatization import lemmatize

def test_happy_lemmatize():
    lemma, err = lemmatize("бегу", "ru")
    assert err is None
    assert lemma == "бег"

def test_unknown_word():
    lemma, err = lemmatize("qwerty", "ru")
    assert err is None
    assert lemma == "qwerty"

def test_empty_word():
    lemma, err = lemmatize("", "ru")
    assert err == "EMPTY_WORD"
    assert lemma is None

def test_empty_language():
    lemma, err = lemmatize("бегу", "")
    assert err == "EMPTY_LANGUAGE"
    assert lemma is None

def test_unsupported_language():
    lemma, err = lemmatize("бегу", "fr")
    assert err == "UNSUPPORTED_LANGUAGE"
    assert lemma is None
