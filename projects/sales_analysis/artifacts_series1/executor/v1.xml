"""MOD-06: Расчёт среднего чека по регионам."""

from typing import Optional, Tuple

import pandas as pd


def avg_check_by_region(df: pd.DataFrame) -> Tuple[Optional[pd.DataFrame], Optional[str]]:
    """Средний чек (средняя выручка на строку) по регионам."""
    if df.empty:
        return None, "EMPTY_DATASET"

    df = df.copy()
    df["revenue"] = df["qty"] * df["price"]
    result = (
        df.groupby("region", as_index=False)
        .agg(avg_check=("revenue", "mean"))
        .sort_values("region")
        .reset_index(drop=True)
    )
    return result, None
