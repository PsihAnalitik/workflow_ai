```file:search.py
import re
from typing import Dict, List, Optional, Tuple

from lemmatization import lemmatize


class SearchResult:
    def __init__(self, text_id: str, positions: List[int]):
        self.text_id = text_id
        self.positions = positions

    def to_dict(self) -> dict:
        return {"text_id": self.text_id, "positions": self.positions}


class SearchEngine:
    def __init__(self, corpus: Dict[str, str]):
        self.corpus = corpus
        # Precompute lemma index for root search
        self.lemma_index: Dict[str, List[Tuple[str, int]]] = {}
        for text_id, text in corpus.items():
            tokens = self._tokenize(text)
            self.lemma_index[text_id] = tokens

    def _tokenize(self, text: str) -> List[Tuple[str, int]]:
        """Tokenize text into (lemma, start_position) tuples."""
        tokens = []
        for match in re.finditer(r'\b\w+\b', text):
            word = match.group()
            start = match.start()
            lemma = lemmatize(word, 'ru')
            tokens.append((lemma, start))
        return tokens

    def exact_search(self, query: str) -> Optional[List[SearchResult]]:
        if not query:
            return None
        results = []
        for text_id, text in self.corpus.items():
            positions = []
            start = 0
            while True:
                pos = text.find(query, start)
                if pos == -1:
                    break
                positions.append(pos)
                start = pos + 1
            if positions:
                results.append(SearchResult(text_id, positions))
        return results

    def word_search(self, query: str) -> Optional[List[SearchResult]]:
        if not query:
            return None
        pattern = r'\b' + re.escape(query) + r'\b'
        results = []
        for text_id, text in self.corpus.items():
            positions = [m.start() for m in re.finditer(pattern, text)]
            if positions:
                results.append(SearchResult(text_id, positions))
        return results

    def root_search(self, query: str, lang: str) -> Optional[List[SearchResult]]:
        if not query:
            return None
        if not lang:
            return None
        if lang != 'ru':
            return None
        query_words = query.split()
        lemma_query = [lemmatize(w, lang) for w in query_words]
        results = []
        for text_id, tokens in self.lemma_index.items():
            # Find continuous subsequence of lemma_query in tokens
            for i in range(len(tokens) - len(lemma_query) + 1):
                match = True
                for j, lemma in enumerate(lemma_query):
                    if tokens[i + j][0] != lemma:
                        match = False
                        break
                if match:
                    start_pos = tokens[i][1]
                    results.append(SearchResult(text_id, [start_pos]))
                    break  # Only first match per text
        return results
