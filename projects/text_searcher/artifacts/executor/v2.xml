from fastapi.testclient import TestClient
from api import app

client = TestClient(app)


def test_exact_search_200():
    resp = client.get("/search/exact", params={"query": "мир"})
    assert resp.status_code == 200
    data = resp.json()
    assert isinstance(data, list)
    assert len(data) == 1
    assert data[0]["text_id"] == "doc1"
    assert set(data[0]["positions"]) == {0, 7}

def test_exact_search_empty_query_400():
    resp = client.get("/search/exact", params={"query": ""})
    assert resp.status_code == 400
    body = resp.json()
    assert body["code"] == "EMPTY_QUERY"
    assert body["message"] != ""

