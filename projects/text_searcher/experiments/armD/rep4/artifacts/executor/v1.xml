        results = engine.word_search("мир")
        assert results is not None
        assert len(results) == 1
        assert results[0].text_id == "doc1"
        assert results[0].positions == [7]  # only whole word "мир"

    def test_no_match(self, engine):
        results = engine.word_search("xyz")
        assert results == []

    def test_empty_query(self, engine):
        results = engine.word_search("")
        assert results is None


class TestRootSearch:
    def test_happy(self, engine):
        results = engine.root_search("бегу", "ru")
        assert results is not None
        assert len(results) == 1
        assert results[0].text_id == "doc2"

