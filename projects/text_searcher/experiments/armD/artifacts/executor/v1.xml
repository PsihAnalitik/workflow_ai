from lemmatization import lemmatize


def test_lemmatize_known_word() -> None:
    result = lemmatize("бегу", "ru")
    assert result is not None
    assert result == "бег"


def test_lemmatize_unknown_word() -> None:
    result = lemmatize("qwerty", "ru")
    assert result is not None
    assert result == "qwerty"


def test_lemmatize_empty_word() -> None:
    result = lemmatize("", "ru")
    assert result is None  # EMPTY_WORD


def test_lemmatize_empty_language() -> None:
    result = lemmatize("test", "")
    assert result is None  # EMPTY_LANGUAGE


def test_lemmatize_unsupported_language() -> None:
    result = lemmatize("test", "fr")
    assert result is None  # UNSUPPORTED_LANGUAGE
