from fastapi import FastAPI, Query
from fastapi.responses import JSONResponse

from search import SearchEngine
from lemmatization import Lemmatizer


# Статический in-memory корпус
CORPUS = {
    "1": "мирный мир",
    "2": "бег трусцой",
    "3": "привет мир",
    "4": "бежать быстро",
}

lemmatizer = Lemmatizer()
search_engine = SearchEngine(CORPUS, lemmatizer)

app = FastAPI()


@app.get("/search/exact")
def exact_search(query: str = Query(...)):
    result, error = search_engine.exact_search(query)
    if error:
        return JSONResponse(
            status_code=400,
            content={"code": error, "message": error},
        )
    return result


@app.get("/search/word")
def word_search(query: str = Query(...)):
    result, error = search_engine.word_search(query)
    if error:
        return JSONResponse(
            status_code=400,
            content={"code": error, "message": error},
        )
    return result


@app.get("/search/root")
def root_search(query: str = Query(...), lang: str = Query(...)):
    result, error = search_engine.root_search(query, lang)
    if error:
        return JSONResponse(
            status_code=400,
            content={"code": error, "message": error},
        )
    return result


@app.get("/lemmatize")
def lemmatize_endpoint(word: str = Query(...), lang: str = Query(...)):
    result, error = lemmatizer.lemmatize(word, lang)
    if error:
        return JSONResponse(
            status_code=400,
            content={"code": error, "message": error},
        )
    return {"lemma": result}
