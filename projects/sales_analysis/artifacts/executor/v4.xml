import pandas as pd

def avg_receipt_by_region(df: pd.DataFrame) -> pd.DataFrame:
    """
    Вычисляет средний чек по регионам как sum(qty*price) / count(*).
    Возвращает DataFrame с колонками ['region', 'avg_receipt'].
    При пустом входе возвращает пустой DataFrame с теми же колонками.
    """
    if df.empty:
        return pd.DataFrame(columns=['region', 'avg_receipt'])
    df = df.copy()
    df['revenue'] = df['qty'] * df['price']
    agg = df.groupby('region').agg(
        revenue_sum=('revenue', 'sum'),
        count=('revenue', 'count')
    ).reset_index()
    agg['avg_receipt'] = agg['revenue_sum'] / agg['count']
    result = agg[['region', 'avg_receipt']]
    return result
