import pytest
from lemmatization import Lemmatizer

@pytest.fixture
def lemmatizer():
    return Lemmatizer()

class TestLemmatize:
    def test_happy(self, lemmatizer):
        result, err = lemmatizer.lemmatize("бегу", "ru")
        assert err is None
        # фактическая лемма для "бегу" в pymorphy3 — "бег"
        assert result == "бег"

    def test_word_not_in_dict(self, lemmatizer):
        result, err = lemmatizer.lemmatize("qwerty", "ru")
        assert err is None
        assert result == "qwerty"

    def test_empty_word(self, lemmatizer):
        result, err = lemmatizer.lemmatize("", "ru")
        assert result is None
        assert err == "EMPTY_WORD"

    def test_empty_language(self, lemmatizer):
        result, err = lemmatizer.lemmatize("бегу", "")
        assert result is None
        assert err == "EMPTY_LANGUAGE"

    def test_unsupported_language(self, lemmatizer):
        result, err = lemmatizer.lemmatize("бегу", "fr")
        assert result is None
        assert err == "UNSUPPORTED_LANGUAGE"
