```file:search.py
import re
from typing import Dict, List, Tuple, Optional
from lemmatization import lemmatize


class SearchResult:
    def __init__(self, text_id: str, positions: List[int]):
        self.text_id = text_id
        self.positions = positions

    def to_dict(self) -> dict:
        return {"text_id": self.text_id, "positions": self.positions}


class SearchEngine:
    def __init__(self, corpus: Dict[str, str]):
        self.corpus = corpus
        # Precompute lemma index for root search: for each text_id, list of (lemma, start_pos)
        self.lemma_index: Dict[str, List[Tuple[str, int]]] = {}
        for text_id, text in corpus.items():
            self.lemma_index[text_id] = self._build_lemma_index(text)

    def _build_lemma_index(self, text: str) -> List[Tuple[str, int]]:
        """Build list of (lemma, start_pos) for each word in text."""
        index: List[Tuple[str, int]] = []
        for match in re.finditer(r'\b\w+\b', text):
            word = match.group()
            start = match.start()
            lemma = lemmatize(word, 'ru')
            index.append((lemma, start))
        return index

    def exact_search(self, query: str) -> Optional[List[SearchResult]]:
        if not query:
            return None  # EMPTY_QUERY
        results: List[SearchResult] = []
        for text_id, text in self.corpus.items():
            positions: List[int] = []
            start = 0
            while True:
                pos = text.find(query, start)
                if pos == -1:
                    break
                positions.append(pos)
                start = pos + 1
            if positions:
                results.append(SearchResult(text_id, positions))
        return results

    def word_search(self, query: str) -> Optional[List[SearchResult]]:
        if not query:
            return None  # EMPTY_QUERY
        results: List[SearchResult] = []
        pattern = r'\b' + re.escape(query) + r'\b'
        for text_id, text in self.corpus.items():
            positions: List[int] = [m.start() for m in re.finditer(pattern, text)]
            if positions:
                results.append(SearchResult(text_id, positions))
        return results

    def root_search(self, query: str, lang: str) -> Optional[List[SearchResult]]:
        if not query:
            return None  # EMPTY_QUERY
        if not lang:
            return None  # EMPTY_LANGUAGE
        if lang != 'ru':
            return None  # UNSUPPORTED_LANGUAGE
        # Lemmatize query words
        query_words = query.split()
        lemma_query = [lemmatize(w, lang) for w in query_words]
        if not lemma_query:
            return []
        results: List[SearchResult] = []
        for text_id, index in self.lemma_index.items():
            # Find continuous subsequence of lemma_query in index
            positions: List[int] = []
            for i in range(len(index) - len(lemma_query) + 1):
                match = True
                for j, lemma in enumerate(lemma_query):
                    if index[i + j][0] != lemma:
                        match = False
                        break
                if match:
                    positions.append(index[i][1])
            if positions:
                results.append(SearchResult(text_id, positions))
        return results
