        'date': pd.to_datetime(['2026-01-05']),
        'value': [1]
    })
    start = pd.Timestamp('2026-03-01')
    end = pd.Timestamp('2026-02-01')  # start > end
    result = filter_by_date(df, start, end)
    assert result is None
