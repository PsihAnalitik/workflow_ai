import pytest
from search import TextSearch

@pytest.fixture
def corpus():
    return {
        "1": "мирный мир",
        "2": "бег трусцой",
        "3": "в бегущем мире",
    }

@pytest.fixture
def searcher(corpus):
    return TextSearch(corpus)

class TestExactSearch:
    def test_happy(self, searcher):
        result, err = searcher.exact_search("мир")
        assert err is None
        assert len(result) == 2
        for r in result:
            if r["text_id"] == "1":
                assert r["positions"] == [0, 7]
            elif r["text_id"] == "3":
                assert r["positions"] == [10]

    def test_empty_query(self, searcher):
        result, err = searcher.exact_search("")
        assert result is None
        assert err == "EMPTY_QUERY"

    def test_no_match(self, searcher):
        result, err = searcher.exact_search("xyz")
        assert result == []
        assert err is None

class TestWordSearch:
    def test_happy(self, searcher):
        result, err = searcher.word_search("мир")
        assert err is None
        assert len(result) == 1
        assert result[0]["text_id"] == "1"
        assert result[0]["positions"] == [7]

    def test_empty_query(self, searcher):
        result, err = searcher.word_search("")
        assert result is None
        assert err == "EMPTY_QUERY"

    def test_no_match(self, searcher):
        result, err = searcher.word_search("xyz")
        assert result == []
        assert err is None

class TestRootSearch:
    def test_happy(self):
        # Корпус, в котором слово "бег" (лемма) есть, запрос "бегу" даёт совпадение
        corpus = {"1": "бег трусцой"}
        searcher = TextSearch(corpus)
        result, err = searcher.root_search("бегу", "ru")
        assert err is None
        assert len(result) == 1
        assert result[0]["text_id"] == "1"
        assert result[0]["positions"] == [0]

    def test_empty_query(self, searcher):
        result, err = searcher.root_search("", "ru")
        assert result is None
        assert err == "EMPTY_QUERY"

    def test_empty_language(self, searcher):
        result, err = searcher.root_search("бегу", "")
        assert result is None
        assert err == "EMPTY_LANGUAGE"

    def test_unsupported_language(self, searcher):
        result, err = searcher.root_search("бегу", "en")
        assert result is None
        assert err == "UNSUPPORTED_LANGUAGE"

    def test_no_match(self, searcher):
        result, err = searcher.root_search("xyzxyz", "ru")
        assert result == []
        assert err is None
