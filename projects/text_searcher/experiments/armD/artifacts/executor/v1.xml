```file:search.py
import re
from typing import Dict, List, Tuple, Optional
from lemmatization import lemmatize


class SearchResult:
    def __init__(self, text_id: str, positions: List[int]):
        self.text_id = text_id
        self.positions = positions

    def to_dict(self) -> dict:
        return {"text_id": self.text_id, "positions": self.positions}


class SearchEngine:
    def __init__(self, corpus: Dict[str, str]):
        self.corpus = corpus
        # Precompute lemma index for root search
        self.lemma_index: Dict[str, List[Tuple[str, int]]] = {}
        for text_id, text in corpus.items():
            tokens = self._tokenize(text)
            lemma_list = []
            for token, pos in tokens:
                lemma = lemmatize(token, "ru")
                if lemma is not None:
                    lemma_list.append((lemma, pos))
            self.lemma_index[text_id] = lemma_list

    def _tokenize(self, text: str) -> List[Tuple[str, int]]:
        """Split text into (word, start_position) tokens."""
        tokens = []
        for match in re.finditer(r'\b\w+\b', text):
            tokens.append((match.group(), match.start()))
        return tokens

    def exact_search(self, query: str) -> Optional[List[SearchResult]]:
        if not query:
            return None  # EMPTY_QUERY
        results = []
        for text_id, text in self.corpus.items():
            positions = []
            start = 0
            while True:
                pos = text.find(query, start)
                if pos == -1:
                    break
                positions.append(pos)
                start = pos + 1
            if positions:
                results.append(SearchResult(text_id, positions))
        return results

    def word_search(self, query: str) -> Optional[List[SearchResult]]:
        if not query:
            return None  # EMPTY_QUERY
        pattern = r'\b' + re.escape(query) + r'\b'
        results = []
        for text_id, text in self.corpus.items():
            positions = [m.start() for m in re.finditer(pattern, text)]
            if positions:
                results.append(SearchResult(text_id, positions))
        return results

    def root_search(self, query: str, lang: str) -> Optional[List[SearchResult]]:
        if not query:
            return None  # EMPTY_QUERY
        if not lang:
            return None  # EMPTY_LANGUAGE
        if lang != 'ru':
            return None  # UNSUPPORTED_LANGUAGE
        query_words = query.split()
        lemma_query = []
        for word in query_words:
            lemma = lemmatize(word, lang)
            if lemma is None:
                return None  # Should not happen if lemmatize handles errors
            lemma_query.append(lemma)
        results = []
        for text_id, lemma_list in self.lemma_index.items():
            # Find continuous subsequence of lemma_query in lemma_list
            if not lemma_query:
                continue
            for i in range(len(lemma_list) - len(lemma_query) + 1):
                match = True
                for j in range(len(lemma_query)):
                    if lemma_list[i + j][0] != lemma_query[j]:
                        match = False
                        break
                if match:
                    start_pos = lemma_list[i][1]
                    results.append(SearchResult(text_id, [start_pos]))
                    break  # Only first match per text
        return results
