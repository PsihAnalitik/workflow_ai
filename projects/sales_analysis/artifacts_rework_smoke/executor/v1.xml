```file:main.py
import sys
import pandas as pd

from modules.mod_01_clean import clean_data
from modules.mod_02_category_revenue import category_revenue
from modules.mod_03_monthly_revenue import monthly_revenue
from modules.mod_04_top3_products import top3_products
from modules.mod_05_avg_check_region import avg_check_by_region
from modules.mod_06_discard_count import discarded_count


def main():
    if len(sys.argv) != 2:
        print("Использование: python main.py <путь_к_csv>")
        sys.exit(1)

    csv_path = sys.argv[1]
    try:
        raw_df = pd.read_csv(
            csv_path,
            parse_dates=["date"],
            dtype={"qty": "Int64", "price": "Int64"},
        )
    except Exception as e:
        print(f"Ошибка при чтении CSV: {e}")
        sys.exit(2)

    # G‑05: количество отброшенных строк
    disc = discarded_count(raw_df)
    # MOD‑01: очистка
    clean = clean_data(raw_df)

    # Рассчёты
    cat_rev = category_revenue(clean)
    month_rev = monthly_revenue(clean)
    top3 = top3_products(clean)
    avg_chk = avg_check_by_region(clean)

    # Вывод результатов
    print("=== FR‑01 Выручка по категориям ===")
    print(cat_rev.to_string(index=False))
    print()

    print("=== FR‑02 Выручка по месяцам ===")
    print(month_rev.to_string(index=False))
    print()

    print("=== FR‑03 Топ‑3 продукта ===")
    print(top3.to_string(index=False))
    print()

    print("=== FR‑04 Средний чек по регионам ===")
    print(avg_chk.to_string(index=False))
    print()

    print("=== FR‑05 Отброшено строк ===")
    print(disc)


if __name__ == "__main__":
    main()
```

```file:modules/mod_01_clean.py
import pandas as pd

def clean_data(df: pd.DataFrame) -> pd.DataFrame:
    """Фильтрация строк без пропусков в qty и price."""
    # входные данные — DataFrame, содержащий колонки qty и price
    # если колонок нет, вернуть пустой DataFrame с теми же колонками
    if "qty" not in df.columns or "price" not in df.columns:
        return pd.DataFrame(columns=df.columns)
    # оставляем строки, где и qty, и price не NaN
    mask = df["qty"].notna() & df["price"].notna()
    return df.loc[mask].copy()
```

```file:modules/mod_02_category_revenue.py
import pandas as pd

def category_revenue(df: pd.DataFrame) -> pd.DataFrame:
    """Суммарная выручка по категориям."""
    if df.empty:
        return pd.DataFrame(columns=["category", "revenue"])
    df = df.copy()
    df["revenue"] = df["qty"] * df["price"]
    result = (
        df.groupby("category", as_index=False)
          .agg(revenue=("revenue", "sum"))
          .sort_values("revenue", ascending=False)
    )
    return result
```

```file:modules/mod_03_monthly_revenue.py
import pandas as pd

def monthly_revenue(df: pd.DataFrame) -> pd.DataFrame:
    """Суммарная выручка по месяцам."""
    if df.empty:
        return pd.DataFrame(columns=["month", "revenue"])
    df = df.copy()
    # считаем, что поле date уже разобрано как datetime (parse_dates при чтении)
    df["month"] = df["date"].dt.to_period("M").astype(str)
    df["revenue"] = df["qty"] * df["price"]
    result = (
        df.groupby("month", as_index=False)
          .agg(revenue=("revenue", "sum"))
          .sort_values("month")
    )
    return result
```

```file:modules/mod_04_top3_products.py
import pandas as pd

def top3_products(df: pd.DataFrame) -> pd.DataFrame:
    """Топ‑3 продуктов по выручке."""
    if df.empty:
        return pd.DataFrame(columns=["product", "revenue"])
    df = df.copy()
    df["revenue"] = df["qty"] * df["price"]
    agg = (
        df.groupby("product", as_index=False)
          .agg(revenue=("revenue", "sum"))
    )
    top3 = agg.sort_values("revenue", ascending=False).head(3)
    return top3.reset_index(drop=True)
```

```file:modules/mod_05_avg_check_region.py
import pandas as pd

def avg_check_by_region(df: pd.DataFrame) -> pd.DataFrame:
    """Средний чек (средняя стоимость транзакции) по регионам."""
    if df.empty:
        return pd.DataFrame(columns=["region", "avg_check"])
    df = df.copy()
    df["revenue"] = df["qty"] * df["price"]
    result = (
        df.groupby("region", as_index=False)
          .agg(avg_check=("revenue", "mean"))
    )
    return result
```

```file:modules/mod_06_discard_count.py
import pandas as pd

def discarded_count(df: pd.DataFrame) -> int:
    """Количество строк с пропусками в qty или price."""
    if "qty" not in df.columns or "price" not in df.columns:
        return len(df)
    mask = df["qty"].isna() | df["price"].isna()
    return int(mask.sum())
```

