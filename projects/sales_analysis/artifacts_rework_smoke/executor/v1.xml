import pandas as pd
from modules.mod_02_category_revenue import category_revenue

def test_category_revenue_happy_path():
    df = pd.DataFrame({
        "category": ["a", "a", "b", "b"],
        "qty": [1, 2, 3, 4],
        "price": [10.0, 20.0, 5.0, 10.0],
    })
    result = category_revenue(df)
    # a: 1*10 + 2*20 = 10+40=50.0; b: 3*5 + 4*10 = 15+40=55.0
    assert list(result["category"]) == ["b", "a"]  # по убыванию
    assert list(result["revenue"]) == [55.0, 50.0]

def test_category_revenue_empty():
    df = pd.DataFrame(columns=["category", "qty", "price"])
    result = category_revenue(df)
    assert result.empty
    assert list(result.columns) == ["category", "revenue"]
