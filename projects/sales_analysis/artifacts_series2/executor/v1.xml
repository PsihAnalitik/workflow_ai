```file:test_mod_02.py
import pandas as pd
from mod_02_category_revenue import revenue_by_category

def test_happy_path() -> None:
    df = pd.DataFrame({
        "category": ["a", "a", "b", "b"],
        "qty": [1, 2, 3, 4],
        "price": [10, 10, 5, 5]
    })
    result = revenue_by_category(df)
    expected = pd.DataFrame({
        "category": ["a", "b"],
        "revenue": [30, 35]   # (1*10+2*10)=30, (3*5+4*5)=35
    })
    pd.testing.assert_frame_equal(result.reset_index(drop=True), expected)

def test_empty_after_filter() -> None:
    df = pd.DataFrame({
        "category": ["a", "b"],
        "qty": [None, 1],
        "price": [100, None]
    })
    result = revenue_by_category(df)
    assert result.empty
    assert list(result.columns) == ["category", "revenue"]
```

