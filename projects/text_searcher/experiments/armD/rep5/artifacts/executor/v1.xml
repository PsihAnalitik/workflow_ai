import pytest
from search import SearchEngine


CORPUS = {
    "doc1": "мирный мир",
    "doc2": "бег трусцой",
    "doc3": "qwerty",
    "doc4": "бегущий человек",
}


@pytest.fixture
def engine() -> SearchEngine:
    return SearchEngine(CORPUS)


class TestExactSearch:
    def test_happy(self, engine: SearchEngine) -> None:
        results = engine.exact_search("мир")
        assert results is not None
        assert len(results) == 1
        assert results[0].text_id == "doc1"
        assert results[0].positions == [0, 7]

    def test_no_match(self, engine: SearchEngine) -> None:
        results = engine.exact_search("xyz")
        assert results is not None
        assert len(results) == 0

    def test_empty_query(self, engine: SearchEngine) -> None:
        results = engine.exact_search("")
        assert results is None


class TestWordSearch:
    def test_happy(self, engine: SearchEngine) -> None:
        results = engine.word_search("мир")
        assert results is not None
        assert len(results) == 1
        assert results[0].text_id == "doc1"
        assert results[0].positions == [7]

    def test_no_match(self, engine: SearchEngine) -> None:
        results = engine.word_search("xyz")
        assert results is not None
        assert len(results) == 0

    def test_empty_query(self, engine: SearchEngine) -> None:
        results = engine.word_search("")
