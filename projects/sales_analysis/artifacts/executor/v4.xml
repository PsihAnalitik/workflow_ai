import pandas as pd

def top3_products(df: pd.DataFrame) -> pd.DataFrame:
    """
    Определяет три продукта с наибольшей суммарной выручкой.
    Возвращает DataFrame с колонками ['product', 'category', 'revenue'].
    Если продуктов меньше трёх, возвращает все.
    При пустом входе возвращает пустой DataFrame с теми же колонками.
    """
    if df.empty:
        return pd.DataFrame(columns=['product', 'category', 'revenue'])
    df = df.copy()
    df['revenue'] = df['qty'] * df['price']
    product_rev = df.groupby(['product', 'category'], as_index=False)['revenue'].sum()
    top = product_rev.nlargest(3, 'revenue')
    return top
