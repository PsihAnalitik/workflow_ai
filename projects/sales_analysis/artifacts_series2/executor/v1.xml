```file:test_mod_04.py
import pandas as pd
from mod_04_top_products import top_products

def test_happy_path() -> None:
    df = pd.DataFrame({
        "product": ["p1", "p2", "p3", "p1", "p4"],
        "qty": [1, 2, 3, 1, 10],
        "price": [100, 50, 20, 100, 5]
    })
    result = top_products(df)
    # revenues: p1=200, p2=100, p3=60, p4=50 → top3: p1, p2, p3
    expected = pd.DataFrame({
        "product": ["p1", "p2", "p3"],
        "revenue": [200, 100, 60]
    })
    pd.testing.assert_frame_equal(result.reset_index(drop=True), expected)

def test_less_than_three_products() -> None:
    df = pd.DataFrame({
        "product": ["x", "y", "x"],
        "qty": [1, 2, 1],
        "price": [10, 20, 10]
    })
    result = top_products(df)
    # revenues: x=20, y=40 → только два продукта
    assert len(result) == 2
    assert set(result["product"]) == {"x", "y"}
```

