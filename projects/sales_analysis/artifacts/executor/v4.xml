import pandas as pd
from typing import Optional

def filter_by_date(df: pd.DataFrame, start_date: pd.Timestamp, end_date: pd.Timestamp) -> Optional[pd.DataFrame]:
    """
    Фильтрует DataFrame по диапазону дат [start_date, end_date].
    Возвращает отфильтрованный DataFrame или None, если start_date > end_date.
    Если после фильтрации нет строк, возвращает пустой DataFrame.
    """
    if start_date > end_date:
        return None
    if 'date' not in df.columns:
        return pd.DataFrame()
    mask = (df['date'] >= start_date) & (df['date'] <= end_date)
    return df.loc[mask].copy()
