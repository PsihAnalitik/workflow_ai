import pandas as pd

def revenue_by_category(df: pd.DataFrame) -> pd.DataFrame:
    """
    Рассчитывает суммарную выручку (qty * price) по категориям.
    Возвращает DataFrame с колонками ['category', 'revenue'].
    При пустом входе возвращает пустой DataFrame с теми же колонками.
    """
    if df.empty:
        return pd.DataFrame(columns=['category', 'revenue'])
    df = df.copy()
    df['revenue'] = df['qty'] * df['price']
    result = df.groupby('category', as_index=False)['revenue'].sum()
    return result
```

```file:revenue_by_month.py
import pandas as pd

def revenue_by_month(df: pd.DataFrame) -> pd.DataFrame:
    """
    Рассчитывает суммарную выручку (qty * price) по месяцам.
    Возвращает DataFrame с колонками ['month', 'revenue'].
    При пустом входе возвращает пустой DataFrame с теми же колонками.
    """
    if df.empty:
        return pd.DataFrame(columns=['month', 'revenue'])
    df = df.copy()
    df['revenue'] = df['qty'] * df['price']
    df['month'] = df['date'].dt.strftime('%Y-%m')
    result = df.groupby('month', as_index=False)['revenue'].sum()
    return result
