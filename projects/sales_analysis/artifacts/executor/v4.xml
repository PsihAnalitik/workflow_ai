```file:main.py
import sys
import pandas as pd
from filter_by_date import filter_by_date
from exclude_missing import exclude_missing
from revenue_by_category import revenue_by_category
from revenue_by_month import revenue_by_month
from top3_products import top3_products
from avg_receipt_by_region import avg_receipt_by_region
from report_formatter import format_report

def main():
    if len(sys.argv) != 4:
        print("Usage: python main.py <path_to_csv> <start_date YYYY-MM-DD> <end_date YYYY-MM-DD>")
        sys.exit(1)
    csv_path = sys.argv[1]
    start_date = pd.Timestamp(sys.argv[2])
    end_date = pd.Timestamp(sys.argv[3])

    # Чтение CSV с правильными типами
    try:
        df = pd.read_csv(
            csv_path,
            parse_dates=['date'],
            dtype={'qty': 'Int64', 'price': 'Int64'}
        )
    except Exception as e:
        print(f"Ошибка чтения CSV: {e}")
        sys.exit(1)

    # Фильтрация по датам
    filtered = filter_by_date(df, start_date, end_date)
    if filtered is None:
        print("Ошибка: start_date > end_date")
        sys.exit(1)

    # Исключение пропусков
    clean_df, excluded_count = exclude_missing(filtered)

    # Расчёты
    rev_cat = revenue_by_category(clean_df)
    rev_mon = revenue_by_month(clean_df)
    top3 = top3_products(clean_df)
    avg_rec = avg_receipt_by_region(clean_df)

    # Формирование и вывод отчёта
    report = format_report(rev_cat, rev_mon, top3, avg_rec, excluded_count)
    print(report)

if __name__ == '__main__':
    main()
