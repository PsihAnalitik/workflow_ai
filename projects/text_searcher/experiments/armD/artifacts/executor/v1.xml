```file:lemmatization.py
from typing import Optional
import pymorphy3


_analyzer = pymorphy3.MorphAnalyzer()


def lemmatize(word: str, lang: str) -> Optional[str]:
    if not word:
        return None  # EMPTY_WORD
    if not lang:
        return None  # EMPTY_LANGUAGE
    if lang != 'ru':
        return None  # UNSUPPORTED_LANGUAGE
    parsed = _analyzer.parse(word)
    if parsed:
        return parsed[0].normal_form
    return word
