from fastapi import FastAPI, Query
from fastapi.responses import JSONResponse

from search import SearchEngine


CORPUS = {
    "doc1": "мирный мир",
    "doc2": "бег трусцой",
    "doc3": "qwerty",
    "doc4": "бегущий человек",
}

app = FastAPI()
engine = SearchEngine(CORPUS)


@app.get("/search/exact")
def search_exact(query: str = Query(...)) -> JSONResponse:
    result = engine.exact_search(query)
    if result is None:
        return JSONResponse(
            status_code=400,
            content={"code": "EMPTY_QUERY", "message": "query is empty"},
        )
    return JSONResponse(status_code=200, content=[r.to_dict() for r in result])


@app.get("/search/word")
def search_word(query: str = Query(...)) -> JSONResponse:
    result = engine.word_search(query)
    if result is None:
        return JSONResponse(
            status_code=400,
            content={"code": "EMPTY_QUERY", "message": "query is empty"},
        )
    return JSONResponse(status_code=200, content=[r.to_dict() for r in result])


@app.get("/search/root")
def search_root(query: str = Query(...), lang: str = Query(...)) -> JSONResponse:
    result = engine.root_search(query, lang)
    if result is None:
        if not query:
            return JSONResponse(
                status_code=400,
                content={"code": "EMPTY_QUERY", "message": "query is empty"},
            )
        if not lang:
            return JSONResponse(
                status_code=400,
                content={"code": "EMPTY_LANGUAGE", "message": "language is empty"},
            )
        return JSONResponse(
            status_code=400,
            content={"code": "UNSUPPORTED_LANGUAGE", "message": f"language '{lang}' is not supported"},
        )
    return JSONResponse(status_code=200, content=[r.to_dict() for r in result])


@app.get("/lemmatize")
def lemmatize_endpoint(word: str = Query(...), lang: str = Query(...)) -> JSONResponse:
    from lemmatization import lemmatize
    result = lemmatize(word, lang)
    if result is None:
        if not word:
            return JSONResponse(
                status_code=400,
                content={"code": "EMPTY_WORD", "message": "word is empty"},
            )
        if not lang:
            return JSONResponse(
                status_code=400,
                content={"code": "EMPTY_LANGUAGE", "message": "language is empty"},
            )
        return JSONResponse(
            status_code=400,
            content={"code": "UNSUPPORTED_LANGUAGE", "message": f"language '{lang}' is not supported"},
        )
    return JSONResponse(status_code=200, content={"lemma": result})
```

```file:lemmatization.py
from typing import Optional

import pymorphy3


_analyzer = pymorphy3.MorphAnalyzer()


def lemmatize(word: str, lang: str) -> Optional[str]:
    if not word:
        return None
    if not lang:
        return None
    if lang != 'ru':
        return None
    parsed = _analyzer.parse(word)
    if parsed:
        return parsed[0].normal_form
    return word
