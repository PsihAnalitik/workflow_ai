# Скопируйте в .env (или экспортируйте в окружение) и заполните значения.
# Ключи в код и конфиги не попадают — адаптеры читают только окружение.
OPENAI_API_KEY=
# Необязательно: переопределение endpoint (прокси, совместимые API).
# Пусто — дефолтный https://api.openai.com/v1
OPENAI_BASE_URL=

TAVILY_API_KEY=