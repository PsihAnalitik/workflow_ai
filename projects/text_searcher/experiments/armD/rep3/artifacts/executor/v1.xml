```file:search.py
import re
from typing import Any
from lemmatization import lemmatize

SearchResult = dict[str, Any]  # {"text_id": str, "positions": list[int]}

class SearchEngine:
    def __init__(self, corpus: dict[str, str]):
        self.corpus = corpus
        # Precompute lemma index for root search
        self.lemma_index: dict[str, list[tuple[str, int]]] = {}
        for text_id, text in corpus.items():
            tokens = []
            pattern = re.compile(r'\b\w+\b')
            for match in pattern.finditer(text):
                word = match.group()
                start = match.start()
                lemma, err = lemmatize(word, "ru")
                if err == "UNSUPPORTED_LANGUAGE":
                    lemma = word  # fallback, should not happen
                tokens.append((lemma, start))
            self.lemma_index[text_id] = tokens

    def exact_search(self, query: str) -> tuple[list[SearchResult] | None, str | None]:
        if not query:
            return None, "EMPTY_QUERY"
        results = []
        for text_id, text in self.corpus.items():
            positions = []
            start = 0
            while True:
                pos = text.find(query, start)
                if pos == -1:
                    break
                positions.append(pos)
                start = pos + 1
            if positions:
                results.append({"text_id": text_id, "positions": positions})
        return results, None

    def word_search(self, query: str) -> tuple[list[SearchResult] | None, str | None]:
        if not query:
            return None, "EMPTY_QUERY"
        results = []
        pattern = re.compile(r'\b' + re.escape(query) + r'\b')
        for text_id, text in self.corpus.items():
            positions = [m.start() for m in pattern.finditer(text)]
            if positions:
                results.append({"text_id": text_id, "positions": positions})
        return results, None

    def root_search(self, query: str, lang: str) -> tuple[list[SearchResult] | None, str | None]:
        if not query:
            return None, "EMPTY_QUERY"
        if not lang:
            return None, "EMPTY_LANGUAGE"
        if lang != "ru":
            return None, "UNSUPPORTED_LANGUAGE"
        query_words = query.split()
        lemma_query = []
        for word in query_words:
            lemma, err = lemmatize(word, lang)
            if err:
                return None, err
            lemma_query.append(lemma)
        results = []
        for text_id, tokens in self.lemma_index.items():
            lemmas = [t[0] for t in tokens]
            if len(lemma_query) == 0:
                continue
            for i in range(len(lemmas) - len(lemma_query) + 1):
                if lemmas[i:i+len(lemma_query)] == lemma_query:
                    results.append({"text_id": text_id, "positions": [tokens[i][1]]})
                    break  # one match per text
        return results, None
