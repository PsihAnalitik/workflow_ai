"""MOD-05: Определение топ-3 продуктов по выручке."""

from typing import Optional, Tuple

import pandas as pd


def top_products(df: pd.DataFrame) -> Tuple[Optional[pd.DataFrame], Optional[str]]:
    """Топ-3 продукта по суммарной выручке (qty * price)."""
    if df.empty:
        return None, "EMPTY_DATASET"

    df = df.copy()
    df["revenue"] = df["qty"] * df["price"]
    product_revenue = (
        df.groupby("product", as_index=False)
        .agg(revenue=("revenue", "sum"))
        .sort_values("revenue", ascending=False)
    )
    top3 = product_revenue.head(3).reset_index(drop=True)
    return top3, None
