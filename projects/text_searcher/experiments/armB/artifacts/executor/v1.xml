```file:search.py
import re
import string
from typing import Dict, List, Optional, Tuple

import pymorphy3

SearchResult = Dict[str, object]  # {"text_id": str, "positions": List[int]}

class TextSearch:
    """Поиск в in-memory корпусе текстов."""

    def __init__(self, corpus: Dict[str, str]) -> None:
        self.corpus = corpus
        self._lemmatizer = pymorphy3.MorphAnalyzer()
        # Предвычисленный индекс лемм для root-поиска
        self._root_index: Dict[str, List[Tuple[str, int]]] = {}
        for text_id, text in corpus.items():
            tokens = text.split()
            pos = 0
            index: List[Tuple[str, int]] = []
            for token in tokens:
                clean = token.strip(string.punctuation)
                if clean:
                    parsed = self._lemmatizer.parse(clean)
                    lemma = parsed[0].normal_form if parsed else clean
                    start = text.find(token, pos)
                    index.append((lemma, start))
                    pos = start + len(token)
            self._root_index[text_id] = index

    def exact_search(self, query: str) -> Tuple[Optional[List[SearchResult]], Optional[str]]:
        """Точный поиск подстроки."""
        if not query:
            return None, "EMPTY_QUERY"

        results: List[SearchResult] = []
        for text_id, text in self.corpus.items():
            positions = []
            start = 0
            while True:
                idx = text.find(query, start)
                if idx == -1:
                    break
                positions.append(idx)
                start = idx + 1
            if positions:
                results.append({"text_id": text_id, "positions": positions})
        return results, None

    def word_search(self, query: str) -> Tuple[Optional[List[SearchResult]], Optional[str]]:
        """Поиск целого слова."""
        if not query:
            return None, "EMPTY_QUERY"

        pattern = r'\b' + re.escape(query) + r'\b'
        results: List[SearchResult] = []
        for text_id, text in self.corpus.items():
            positions = [m.start() for m in re.finditer(pattern, text)]
            if positions:
                results.append({"text_id": text_id, "positions": positions})
        return results, None

    def root_search(self, query: str, lang: str) -> Tuple[Optional[List[SearchResult]], Optional[str]]:
        """Поиск по корню (лемме)."""
        if not query:
            return None, "EMPTY_QUERY"
        if not lang:
            return None, "EMPTY_LANGUAGE"
        if lang != "ru":
            return None, "UNSUPPORTED_LANGUAGE"

        # Лемматизация слов запроса
        query_words = query.split()
        lemma_query = []
        for word in query_words:
            parsed = self._lemmatizer.parse(word)
            lemma = parsed[0].normal_form if parsed else word
            lemma_query.append(lemma)

        results: List[SearchResult] = []
        for text_id, index in self._root_index.items():
            n = len(lemma_query)
            for i in range(len(index) - n + 1):
                if all(index[i + j][0] == lemma_query[j] for j in range(n)):
                    pos = index[i][1]
                    results.append({"text_id": text_id, "positions": [pos]})
                    break  # первое вхождение на текст
        return results, None
