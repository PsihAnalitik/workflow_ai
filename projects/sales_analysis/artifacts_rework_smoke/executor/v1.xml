from datetime import datetime
from modules.mod_03_monthly_revenue import monthly_revenue

def test_monthly_revenue_happy_path():
    df = pd.DataFrame({
        "date": [datetime(2026, 1, 5), datetime(2026, 1, 15), datetime(2026, 2, 10)],
        "qty": [1, 2, 3],
        "price": [10, 20, 5],
    })
    result = monthly_revenue(df)
    # Январь: 1*10+2*20=50; Февраль: 3*5=15
    expected_months = ["2026-01", "2026-02"]
    assert list(result["month"]) == expected_months
    assert list(result["revenue"]) == [50.0, 15.0]

def test_monthly_revenue_empty():
    df = pd.DataFrame(columns=["date", "qty", "price"])
    result = monthly_revenue(df)
    assert result.empty
    assert list(result.columns) == ["month", "revenue"]
