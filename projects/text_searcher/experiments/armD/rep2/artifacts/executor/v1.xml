from lemmatization import lemmatize


def test_lemmatize_known_word() -> None:
    lemma = lemmatize("бегу", "ru")
    assert lemma is not None
    assert lemma == "бег"


def test_lemmatize_unknown_word() -> None:
    lemma = lemmatize("qwerty", "ru")
    assert lemma is not None
    assert lemma == "qwerty"


def test_lemmatize_empty_word() -> None:
    lemma = lemmatize("", "ru")
    assert lemma is None


def test_lemmatize_empty_language() -> None:
    lemma = lemmatize("test", "")
    assert lemma is None


def test_lemmatize_unsupported_language() -> None:
    lemma = lemmatize("test", "fr")
    assert lemma is None
