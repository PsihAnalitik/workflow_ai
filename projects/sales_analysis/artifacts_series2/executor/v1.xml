import pandas as pd
from mod_05_avg_receipt import avg_receipt_by_region

def test_happy_path() -> None:
    df = pd.DataFrame({
        "region": ["msk", "msk", "spb"],
        "qty": [2, 3, 1],
        "price": [100, 200, 500]
    })
    result = avg_receipt_by_region(df)
    # msk: (200+600)/2 = 400.0, spb: 500/1 = 500.0
    expected = pd.DataFrame({
        "region": ["msk", "spb"],
        "avg_receipt": [400.0, 500.0]
    })
    pd.testing.assert_frame_equal(result.reset_index(drop=True), expected, check_exact=False, atol=0.01)

def test_empty_after_filter() -> None:
    df = pd.DataFrame({
        "region": ["a"],
        "qty": [None],
        "price": [10]
    })
    result = avg_receipt_by_region(df)
    assert result.empty
    assert list(result.columns) == ["region", "avg_receipt"]
