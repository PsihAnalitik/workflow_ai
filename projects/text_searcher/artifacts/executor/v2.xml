from fastapi import FastAPI, Query
from fastapi.responses import JSONResponse
from search import Searcher
from lemmatization import lemmatize

# Static in-memory corpus: two documents covering all search examples
CORPUS = {
    "doc1": "мирный мир",
    "doc2": "бег трусцой"
}

app = FastAPI()
searcher = Searcher(CORPUS)


@app.get("/search/exact")
def search_exact(query: str = Query(...)):
    results, err = searcher.exact_search(query)
    if err:
        return JSONResponse(status_code=400, content={"code": err, "message": f"Ошибка: {err}"})
    return JSONResponse(content=results)


@app.get("/search/word")
def search_word(query: str = Query(...)):
    results, err = searcher.word_search(query)
    if err:
        return JSONResponse(status_code=400, content={"code": err, "message": f"Ошибка: {err}"})
    return JSONResponse(content=results)


@app.get("/search/root")
def search_root(query: str = Query(...), lang: str = Query(...)):
    results, err = searcher.root_search(query, lang)
    if err:
        return JSONResponse(status_code=400, content={"code": err, "message": f"Ошибка: {err}"})
    return JSONResponse(content=results)


@app.get("/lemmatize")
def lemmatize_endpoint(word: str = Query(...), lang: str = Query(...)):
    lemma, err = lemmatize(word, lang)
    if err:
        return JSONResponse(status_code=400, content={"code": err, "message": f"Ошибка: {err}"})
    return JSONResponse(content={"lemma": lemma})
