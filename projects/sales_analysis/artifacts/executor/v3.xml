```file:main.py
import sys
import pandas as pd
from mod_01_filter import filter_by_date
from mod_02_exclude import exclude_missing
from mod_03_revenue_by_category import revenue_by_category
from mod_04_revenue_by_month import revenue_by_month
from mod_05_top3 import top3_products
from mod_06_avg_receipt import avg_receipt_by_region
from mod_07_report import format_report

def main() -> None:
    if len(sys.argv) < 2:
        print("Usage: python main.py <path_to_csv>")
        sys.exit(1)

    path = sys.argv[1]
    df = pd.read_csv(path, parse_dates=["date"], dtype={"qty": "Int64", "price": "Int64"})

    # Определение квартала по максимальной дате
    if df.empty:
        print("Файл не содержит данных.")
        return

    max_date = df["date"].max()
    year = max_date.year
    quarter = max_date.quarter
    if quarter == 1:
        start_date = f"{year}-01-01"
        end_date = f"{year}-03-31"
    elif quarter == 2:
        start_date = f"{year}-04-01"
        end_date = f"{year}-06-30"
    elif quarter == 3:
        start_date = f"{year}-07-01"
        end_date = f"{year}-09-30"
    else:
        start_date = f"{year}-10-01"
        end_date = f"{year}-12-31"

    # Фильтрация по кварталу
    filtered_df, err = filter_by_date(df, start_date, end_date)
    if err:
        print(f"Ошибка фильтрации: {err}")
        return

    if filtered_df.empty:
        # Если данных нет, отчёт всё равно формируется
        clean_df = filtered_df
        excluded_count = 0
    else:
        clean_df, excluded_count = exclude_missing(filtered_df)

    # Расчёт аналитических показателей
    rev_cat = revenue_by_category(clean_df)
    rev_month = revenue_by_month(clean_df)
    top3 = top3_products(clean_df)
    avg_rec = avg_receipt_by_region(clean_df)

    report = format_report(rev_cat, rev_month, top3, avg_rec, excluded_count)
    print(report)

if __name__ == "__main__":
    main()
```

```file:mod_01_filter.py
import pandas as pd
from typing import Optional, Tuple

def filter_by_date(
    df: pd.DataFrame, start_date: str, end_date: str
) -> Tuple[Optional[pd.DataFrame], Optional[str]]:
    """Фильтрация строк по интервалу дат [start_date, end_date].

    Возвращает (filtered_df, None) при успехе, иначе (None, сообщение об ошибке).
    """
    if start_date > end_date:
        return None, "INVALID_DATE_RANGE"

    if not pd.api.types.is_datetime64_any_dtype(df["date"]):
        df = df.copy()
        df["date"] = pd.to_datetime(df["date"])

    start = pd.Timestamp(start_date)
    end = pd.Timestamp(end_date)
    mask = (df["date"] >= start) & (df["date"] <= end)
    filtered_df = df.loc[mask].reset_index(drop=True)
    return filtered_df, None
```

```file:mod_02_exclude.py
import pandas as pd
from typing import Tuple

def exclude_missing(
    df: pd.DataFrame,
) -> Tuple[pd.DataFrame, int]:
    """Удаляет строки с пропусками в qty или price, возвращает (чистый df, количество исключённых)."""
    if df.empty:
        return df, 0

    missing_mask = df["qty"].isna() | df["price"].isna()
    excluded_count = missing_mask.sum()
    clean_df = df[~missing_mask].reset_index(drop=True)
    return clean_df, excluded_count
```

```file:mod_03_revenue_by_category.py
import pandas as pd

def revenue_by_category(df: pd.DataFrame) -> pd.DataFrame:
    """Выручка по категориям: столбцы category, revenue."""
    if df.empty:
        return pd.DataFrame(columns=["category", "revenue"])

    df = df.copy()
    df["revenue"] = df["qty"] * df["price"]
    result = (
        df.groupby("category", as_index=False)
        .agg(revenue=("revenue", "sum"))
        .sort_values("revenue", ascending=False)
        .reset_index(drop=True)
    )
    return result
```

```file:mod_04_revenue_by_month.py
import pandas as pd

def revenue_by_month(df: pd.DataFrame) -> pd.DataFrame:
    """Выручка по месяцам: столбцы month, revenue."""
    if df.empty:
        return pd.DataFrame(columns=["month", "revenue"])

    df = df.copy()
    if not pd.api.types.is_datetime64_any_dtype(df["date"]):
        df["date"] = pd.to_datetime(df["date"])
    df["month"] = df["date"].dt.strftime("%Y-%m")
    df["revenue"] = df["qty"] * df["price"]
    result = (
        df.groupby("month", as_index=False)
        .agg(revenue=("revenue", "sum"))
        .sort_values("month")
        .reset_index(drop=True)
    )
    return result
```

```file:mod_05_top3.py
import pandas as pd

def top3_products(df: pd.DataFrame) -> pd.DataFrame:
    """Топ-3 продукта по выручке: столбцы product, category, revenue."""
    if df.empty:
        return pd.DataFrame(columns=["product", "category", "revenue"])

    df = df.copy()
    df["revenue"] = df["qty"] * df["price"]
    agg = (
        df.groupby(["product", "category"], as_index=False)
        .agg(revenue=("revenue", "sum"))
        .sort_values("revenue", ascending=False)
        .head(3)
        .reset_index(drop=True)
    )
    return agg
