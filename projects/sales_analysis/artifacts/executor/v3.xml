```file:test_mod_01_filter.py
import pandas as pd
from mod_01_filter import filter_by_date

def test_filter_by_date_happy_path() -> None:
    df = pd.DataFrame({
        "date": pd.to_datetime(["2026-01-05", "2026-02-20", "2026-04-01"]),
        "value": [10, 20, 30],
    })
    result, err = filter_by_date(df, "2026-01-01", "2026-03-31")
    assert err is None
    assert result is not None
    assert len(result) == 2
    assert result.iloc[0]["date"] == pd.Timestamp("2026-01-05")
    assert result.iloc[1]["date"] == pd.Timestamp("2026-02-20")

def test_filter_by_date_invalid_range() -> None:
    df = pd.DataFrame({"date": pd.to_datetime(["2026-01-05"])})
    result, err = filter_by_date(df, "2026-03-01", "2026-01-01")
    assert result is None
    assert err == "INVALID_DATE_RANGE"

def test_filter_by_date_no_rows() -> None:
    df = pd.DataFrame({
        "date": pd.to_datetime(["2026-01-05", "2026-02-20"]),
        "value": [10, 20],
    })
    result, err = filter_by_date(df, "2025-01-01", "2025-12-31")
    assert err is None
    assert result is not None
    assert result.empty
