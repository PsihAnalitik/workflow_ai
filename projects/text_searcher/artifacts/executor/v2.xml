```file:search.py
import re
from typing import Dict, List, Tuple, Optional
from lemmatization import lemmatize

class Searcher:
    def __init__(self, corpus: Dict[str, str]):
        self.corpus = corpus
        self.lemma_index: Dict[str, List[Tuple[str, int]]] = {}
        # build lemma index for root-search (only Russian is supported)
        for doc_id, text in corpus.items():
            token_matches = re.finditer(r'\b\w+\b', text)
            doc_lemmas = []
            for m in token_matches:
                word = m.group()
                # always use 'ru' because only Russian is supported
                lemma, _ = lemmatize(word, 'ru')
                doc_lemmas.append((lemma, m.start()))
            self.lemma_index[doc_id] = doc_lemmas

    def exact_search(self, query: str) -> Tuple[Optional[List[dict]], Optional[str]]:
        if not query:
            return None, "EMPTY_QUERY"
        results = []
        for text_id, text in self.corpus.items():
            positions = []
            start = 0
            while (start := text.find(query, start)) != -1:
                positions.append(start)
                start += 1
            if positions:
                results.append({"text_id": text_id, "positions": positions})
        return results, None

    def word_search(self, query: str) -> Tuple[Optional[List[dict]], Optional[str]]:
        if not query:
            return None, "EMPTY_QUERY"
        results = []
        pattern = r'\b' + re.escape(query) + r'\b'
        for text_id, text in self.corpus.items():
            positions = [m.start() for m in re.finditer(pattern, text)]
            if positions:
                results.append({"text_id": text_id, "positions": positions})
        return results, None

    def root_search(self, query: str, lang: str) -> Tuple[Optional[List[dict]], Optional[str]]:
        if not query:
            return None, "EMPTY_QUERY"
        if not lang:
            return None, "EMPTY_LANGUAGE"
        if lang != "ru":
            return None, "UNSUPPORTED_LANGUAGE"

        # tokenise query the same way as corpus
        query_tokens = re.findall(r'\b\w+\b', query)
        lemma_query = []
        for token in query_tokens:
            lemma, _ = lemmatize(token, lang)
            lemma_query.append(lemma)

        results = []
        for text_id, text in self.corpus.items():
            index = self.lemma_index.get(text_id, [])
            # search for a contiguous subsequence of lemma_query
            for i in range(len(index) - len(lemma_query) + 1):
                match = True
                for j in range(len(lemma_query)):
                    if index[i + j][0] != lemma_query[j]:
                        match = False
                        break
                if match:
                    start_pos = index[i][1]
                    results.append({"text_id": text_id, "positions": [start_pos]})
                    break  # one result per document, stop after first match
        return results, None
