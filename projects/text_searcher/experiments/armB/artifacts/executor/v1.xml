import pytest
from fastapi.testclient import TestClient
from api import app, get_search, get_lemmatizer
from search import TextSearch
from lemmatization import Lemmatizer

@pytest.fixture(autouse=True)
def override_deps():
    """Подмена зависимостей для тестов (in-memory, без сети)."""
    test_corpus = {
        "1": "мирный мир",
        "2": "бег трусцой",
        "3": "в бегущем мире",
    }
    test_search = TextSearch(test_corpus)
    test_lemmatizer = Lemmatizer()

    def override_search():
        return test_search

    def override_lemmatizer():
        return test_lemmatizer

    app.dependency_overrides = {}
    app.dependency_overrides[get_search] = override_search
    app.dependency_overrides[get_lemmatizer] = override_lemmatizer
    yield
    app.dependency_overrides.clear()

client = TestClient(app)

class TestSearchExact:
