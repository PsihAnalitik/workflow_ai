import pytest
from search import SearchEngine, SearchResult


@pytest.fixture
def engine():
    corpus = {
        "doc1": "мирный мир",
        "doc2": "бег трусцой",
        "doc3": "qwerty test",
        "doc4": "бегущий человек",
    }
    return SearchEngine(corpus)


class TestExactSearch:
    def test_happy(self, engine):
        results = engine.exact_search("мир")
        assert results is not None
        assert len(results) == 1
        assert results[0].text_id == "doc1"
        assert results[0].positions == [0, 7]  # "мир" at 0 and 7 in "мирный мир"

    def test_no_match(self, engine):
        results = engine.exact_search("xyz")
        assert results == []

    def test_empty_query(self, engine):
        results = engine.exact_search("")
        assert results is None  # EMPTY_QUERY


class TestWordSearch:
    def test_happy(self, engine):
        results = engine.word_search("мир")
        assert results is not None
        assert len(results) == 1
        assert results[0].text_id == "doc1"
        assert results[0].positions == [7]  # only whole word "мир" at position 7

    def test_no_match(self, engine):
        results = engine.word_search("xyz")
        assert results == []

    def test_empty_query(self, engine):
        results = engine.word_search("")
        assert results is None  # EMPTY_QUERY


class TestRootSearch:
    def test_happy(self, engine):
        results = engine.root_search("бегу", "ru")
        assert results is not None
        assert len(results) == 1
        assert results[0].text_id == "doc2"
        # "бег" is lemma of "бегу", matches "бег" in "бег трусцой"
        assert results[0].positions == [0]

    def test_no_match(self, engine):
        results = engine.root_search("xyz", "ru")
        assert results == []

    def test_empty_query(self, engine):
        results = engine.root_search("", "ru")
        assert results is None  # EMPTY_QUERY

    def test_empty_language(self, engine):
        results = engine.root_search("бегу", "")
        assert results is None  # EMPTY_LANGUAGE

    def test_unsupported_language(self, engine):
        results = engine.root_search("бегу", "en")
        assert results is None  # UNSUPPORTED_LANGUAGE

    def test_unknown_word(self, engine):
        results = engine.root_search("qwerty", "ru")
        assert results is not None
        assert len(results) == 1
        assert results[0].text_id == "doc3"
        assert results[0].positions == [0]
