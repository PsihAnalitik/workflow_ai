from fastapi import FastAPI, Query
from fastapi.responses import JSONResponse
from search import SearchEngine
from lemmatization import lemmatize

app = FastAPI()

# Static corpus
_corpus = {
    "doc1": "мирный мир",
    "doc2": "бег трусцой",
    "doc3": "qwerty test",
}
_engine = SearchEngine(_corpus)


@app.get("/search/exact")
def search_exact(query: str = Query(...)):
    result = _engine.exact_search(query)
    if result is None:
        return JSONResponse(
            status_code=400,
            content={"code": "EMPTY_QUERY", "message": "query is empty"}
        )
    return JSONResponse(
        status_code=200,
        content=[r.to_dict() for r in result]
    )


@app.get("/search/word")
def search_word(query: str = Query(...)):
    result = _engine.word_search(query)
    if result is None:
        return JSONResponse(
            status_code=400,
            content={"code": "EMPTY_QUERY", "message": "query is empty"}
        )
    return JSONResponse(
        status_code=200,
        content=[r.to_dict() for r in result]
    )


@app.get("/search/root")
def search_root(query: str = Query(...), lang: str = Query(...)):
    if not query:
        return JSONResponse(
            status_code=400,
            content={"code": "EMPTY_QUERY", "message": "query is empty"}
        )
    if not lang:
        return JSONResponse(
            status_code=400,
            content={"code": "EMPTY_LANGUAGE", "message": "language is empty"}
        )
    if lang != 'ru':
        return JSONResponse(
            status_code=400,
            content={"code": "UNSUPPORTED_LANGUAGE", "message": "only 'ru' is supported"}
        )
    result = _engine.root_search(query, lang)
    if result is None:
        return JSONResponse(
            status_code=400,
            content={"code": "EMPTY_QUERY", "message": "query is empty"}
        )
    return JSONResponse(
        status_code=200,
        content=[r.to_dict() for r in result]
    )


@app.get("/lemmatize")
def lemmatize_endpoint(word: str = Query(...), lang: str = Query(...)):
    if not word:
        return JSONResponse(
            status_code=400,
            content={"code": "EMPTY_WORD", "message": "word is empty"}
        )
    if not lang:
        return JSONResponse(
            status_code=400,
            content={"code": "EMPTY_LANGUAGE", "message": "language is empty"}
        )
    if lang != 'ru':
        return JSONResponse(
            status_code=400,
            content={"code": "UNSUPPORTED_LANGUAGE", "message": "only 'ru' is supported"}
        )
    result = lemmatize(word, lang)
    if result is None:
        return JSONResponse(
            status_code=400,
            content={"code": "EMPTY_WORD", "message": "word is empty"}
        )
    return JSONResponse(
        status_code=200,
        content={"lemma": result}
    )
