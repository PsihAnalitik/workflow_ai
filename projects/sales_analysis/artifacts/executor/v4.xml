```file:report_formatter.py
import pandas as pd
from typing import Tuple

def format_report(
    revenue_by_cat: pd.DataFrame,
    revenue_by_mon: pd.DataFrame,
    top3: pd.DataFrame,
    avg_receipt: pd.DataFrame,
    excluded_count: int
) -> str:
    """
    Формирует итоговый отчёт в виде строки с заголовками и таблицами.
    """
    lines = []
    lines.append("Выручка по категориям")
    if not revenue_by_cat.empty:
        lines.append(revenue_by_cat.to_string(index=False))
    else:
        lines.append("(нет данных)")
    lines.append("")
    lines.append("Выручка по месяцам")
    if not revenue_by_mon.empty:
        lines.append(revenue_by_mon.to_string(index=False))
    else:
        lines.append("(нет данных)")
    lines.append("")
    lines.append("Топ-3 продукта")
    if not top3.empty:
        lines.append(top3.to_string(index=False))
    else:
        lines.append("(нет данных)")
    lines.append("")
    lines.append("Средний чек по регионам")
    if not avg_receipt.empty:
        lines.append(avg_receipt.to_string(index=False))
    else:
        lines.append("(нет данных)")
    lines.append("")
    lines.append(f"Исключено строк с пропусками: {excluded_count}")
    return "\n".join(lines)
