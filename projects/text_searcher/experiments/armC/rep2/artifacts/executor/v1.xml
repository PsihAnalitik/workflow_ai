import pytest
from lemmatization import lemmatize


class TestLemmatize:
    def test_happy(self):
        result = lemmatize("бегу", "ru")
        assert result == "бег"

    def test_unknown_word(self):
        result = lemmatize("qwerty", "ru")
        assert result == "qwerty"

    def test_empty_word(self):
        result = lemmatize("", "ru")
        assert result is None  # EMPTY_WORD

    def test_empty_language(self):
        result = lemmatize("бегу", "")
        assert result is None  # EMPTY_LANGUAGE

    def test_unsupported_language(self):
        result = lemmatize("бегу", "fr")
        assert result is None  # UNSUPPORTED_LANGUAGE
